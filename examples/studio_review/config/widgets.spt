insert = SearchType.create('config/widget_config')
insert.set_value('code', 'STUDIO_REVIEW_WIDGET')
insert.set_value('view', 'studio_review.widget')
insert.set_value('search_type', 'studio/review')
insert.set_value('category', 'CustomLayoutWdg')
insert.set_value('widget_type', 'widget')
insert.set_value('config', '<config>\n  <studio_review.widget layout="sobject-layout" collection="list" columns="12" padding="12 12 12 12" gap="8">\n    <element name="title" title="Review" row="1" height="36"><display class="title"><bind>record.name</bind></display></element>\n    <element name="description" title="Description" row="2" height="52"><display class="description"><bind>record.description</bind></display></element>\n    <element name="status" title="Review status" row="3" height="64"><display class="view"><view>studio_review.column</view></display></element>\n    <element name="notes" title="Notes" row="4" height="36"><display class="button"><action>notes</action><text>Notes</text></display></element>\n  </studio_review.widget>\n</config>\n')
#-- End Entry --#
