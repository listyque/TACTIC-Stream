insert.set_value('script', """from thlib.environment import env_inst
from PySide import QtCore, QtGui


class SpinBoxDelegate(QtGui.QStyledItemDelegate):
    def paint(self, painter, option, index):
        print index.column()
        if index.column() == 3:
            print 3
        else:
            
            QStyledItemDelegate.paint(self, painter, option, index)

    def sizeHint(self, option, index):
        
        if index.column() == 3:
            print 'size'
        else:
            return QStyledItemDelegate.sizeHint(self, option, index)

'''
    def createEditor(self, parent, option, index):
        editor = QtGui.QSpinBox(parent)
        editor.setMinimum(0)
        editor.setMaximum(100)

        return editor

    def setEditorData(self, spinBox, index):
        value = index.model().data(index, QtCore.Qt.EditRole)

        spinBox.setValue(value)

    def setModelData(self, spinBox, model, index):
        spinBox.interpretText()
        value = spinBox.value()

        model.setData(index, value, QtCore.Qt.EditRole)

    def updateEditorGeometry(self, editor, option, index):
        editor.setGeometry(option.rect)
'''

dlg = QtGui.QDialog(env_inst.ui_main)
dlg.setWindowTitle("Spin Box Delegate")
dlg.resize(250, 200)

tree_widget = QtGui.QTreeWidget(dlg)
tree_widget.addTopLevelItem(QtGui.QTreeWidgetItem())
tree_widget.addTopLevelItem(QtGui.QTreeWidgetItem())
tree_widget.addTopLevelItem(QtGui.QTreeWidgetItem())
tree_widget.addTopLevelItem(QtGui.QTreeWidgetItem())

delegate = SpinBoxDelegate()
treeView.setItemDelegate(delegate)

for row in range(4):
    for column in range(2):
        index = model.index(row, column, QtCore.QModelIndex())
        model.setData(index, (row + 1) * (column + 1))


dlg.show()
""")
