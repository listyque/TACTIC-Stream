insert.set_value('code', """CUSTOM_SCRIPT00082""")
insert.set_value('folder', """tasks""")
insert.set_value('language', """python""")
insert.set_value('script', """from pyasm.search import Search, SearchKey
from pyasm.biz import Task
# adding initial task for added Episode

server.set_project(server.get_project())

search_code = input['sobject'].get('search_code')
search_type = input['sobject'].get('search_type')

search_key = server.build_search_key(search_type, search_code)

if search_key and search_type == 'cg/scenes?project={}'.format(server.get_project()):
    
    assigned_user = input['sobject'].get('assigned')
    
    related_sobject = SearchKey.get_by_search_key(search_key)
    current_pipeline = related_sobject.get_value('pipeline_code')

    # assign user to the animation Task!

    if assigned_user:
        
        if current_pipeline in ['cg/shorts', 'cg/scenes']:
            Task.add_initial_tasks(related_sobject, processes=['animation'], skip_duplicate=True, assigned=assigned_user, status=u'Назначен')
        
        elif current_pipeline == 'cg/dialog':
            Task.add_initial_tasks(related_sobject, processes=['voice'], skip_duplicate=True, status=u'Готов к работе')
            Task.add_initial_tasks(related_sobject, processes=['animation'], skip_duplicate=True, assigned=assigned_user, status=u'На паузе')

        elif current_pipeline == 'cg/songs':
            Task.add_initial_tasks(related_sobject, processes=['vocal'], skip_duplicate=True, status=u'Готов к работе')
            Task.add_initial_tasks(related_sobject, processes=['animation'], skip_duplicate=True, assigned=assigned_user, status=u'На паузе')
    else:

        if current_pipeline == 'cg/songs':
            Task.add_initial_tasks(related_sobject, processes=['vocal'], skip_duplicate=True, status=u'Готов к работе')

        elif current_pipeline == 'cg/dialog':
            Task.add_initial_tasks(related_sobject, processes=['voice'], skip_duplicate=True, status=u'Готов к работе')
     
""")
