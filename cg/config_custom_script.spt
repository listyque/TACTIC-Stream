insert.set_value('script', """if input.get('sobject'):
    sobject = input['sobject'].get_value
if input.get('snapshot'):
    snapshot = input['snapshot'].get_value
if input.get('file_object'):
    file_object = input['file_object'].get_value
else:
    return None
#parent = input['sobject'].get_parent()
ext = input.get('ext')

#publish_dir_expr = "{project.code}/episodes/{sobject.name}/renders{@CASE( @GET(file.type) == 'playblast', '/'+'__preview', @GET(file.type) == 'web',  '/'+'__preview/web', @GET(file.type) == 'icon', '/'+'__preview/icon')}"
#dir_expr = "{project.code}/episodes/{sobject.name}/{snapshot.process}{@CASE( @GET(file.type) == 'playblast', '/'+'__preview', @GET(file.type) == 'web',  '/'+'__preview/web', @GET(file.type) == 'icon', '/'+'__preview/icon')}"

#version_expr = "{sobject.name}_{basefile}_{snapshot.context}_v{version}.{ext}"
#versionless_expr = "{sobject.name}_{snapshot.context}.{ext}"

version = int(snapshot('version'))
if version in [-1, 0]:
    version = None

if ext:
    if version:
        if snapshot('process') == 'publish':
            full_name = u'{0}_{1}_{2}_v{3:03d}{4}'.format(sobject('name'), file_object('file_name'), snapshot('context'), version, ext)
        else:
            full_name = u'{0}_{1}_v{2:03d}{3}'.format(sobject('name'), snapshot('context'), version, ext)
    else:
        full_name = u'{0}_{1}{2}'.format(sobject('name'), snapshot('context'), ext)
    
    return full_name.replace('/', '_')
else:
    if file_object('type') == 'web':
        preview_path = u'/__preview/web'
    elif file_object('type') == 'icon':
        preview_path = u'/__preview/icon'
    elif file_object('type') == 'playblast':
        preview_path = u'/__preview'
    else:
        preview_path = u''
       
    if snapshot('process') == 'publish':
        full_dir = u'niki_friends/episodes/{0}/{1}{2}'.format(sobject('name'), 'renders', preview_path)
    else:
        full_dir = u'niki_friends/episodes/{0}/{1}{2}'.format(sobject('name'), snapshot('process'), preview_path)
    
    return full_dir""")
