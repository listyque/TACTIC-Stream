insert.set_value('language', """python""")
insert.set_value('s_status', """retired""")
insert.set_value('script', """from pyasm.prod.biz import ProdSetting


telegram_notifications_enabled = ProdSetting.get_value_by_key('telegram_notifications_enabled')

telegram_notifications_enabled = bool(int(telegram_notifications_enabled))


import telegram
bot = telegram.Bot(token='690330253:AAFdFCBJSj_bz7digLAHa4DUIFNe4PlQ6vA')


### DEFAULT STATUSES ###

ASSIGNED = u'Назначен'
IN_PROGRESS = u'В работе'
NEED_HELP = u'Нужна помощь'
REVISE = u'Пересмотр'
DECLINED = u'Отклонен'
ON_REVIEW = u'На проверке'
APPROVED = u'Принят'

STATUS = input['update_data'].get('status')
#***LOGGING

#from pprint import pformat

CHECK_ID = 479912061
SUPERVISORS_IDS = [439209891, 380043516]

#mess = pformat(input)
#message = bot.send_message(chat_id=CHECK_ID, text=mess)

#***LOGGING

if input['sobject'].get('search_code') in ['SCENES00195', 'SCENES00129', 'SCENES00196', 'SCENES00213', 'SCENES00214', 'SCENES00215']:
    telegram_notifications_enabled = False

if telegram_notifications_enabled:
    
    def sending_guess(status):
        send_to_user = False
        send_to_supervisor = False
        
        if status in [ASSIGNED, REVISE, DECLINED, APPROVED, IN_PROGRESS, NEED_HELP, ON_REVIEW]:
            send_to_user = True
    
        if status in [ASSIGNED, REVISE, DECLINED, APPROVED, IN_PROGRESS, NEED_HELP, ON_REVIEW]:
            send_to_supervisor = True
        
        return send_to_user, send_to_supervisor
    
    
    def get_users_from_task_sobj(sobj):
        assigned_user = sobj.get('assigned')
        if not assigned_user:
            assigned_user = input['update_data'].get('assigned')
            
        supervisor_user = sobj.get('supervisor')
        
        if assigned_user:
            assigned_user = server.eval("@SOBJECT(sthpw/login['login','{0}'])".format(assigned_user))[0]
        if supervisor_user:
            supervisor_user = server.eval("@SOBJECT(sthpw/login['login','{0}'])".format(supervisor_user))[0]
        
        return assigned_user, supervisor_user
    
    assigned_user, supervisor_user = get_users_from_task_sobj(input['sobject'])
    
    assigned_user_chat_id = None
    if assigned_user:
        assigned_user_chat_id = assigned_user['phone_number']
    
    supervisor_user_chat_id = None
    if supervisor_user:
        supervisor_user_chat_id = supervisor_user['phone_number']
    
    
    def generate_task_info_message(input, assigned_user):
        message_text = None
    
        if input['mode'] == 'insert':
    
            task_sobject = input['sobject']
            
            filters = [('code', task_sobject['search_code'])]
            related_sobject = server.query(task_sobject['search_type'], filters, single=True)
    
            status = input['update_data'].get('status')
    
    
            if not status:
                status = ASSIGNED
    
            user_telegram_login = bot.get_chat(assigned_user_chat_id)['username']
    
    
            assigned_user_title = u'{0} {1} @{2}'.format(assigned_user['first_name'], assigned_user['last_name'], user_telegram_login)
    
            related_sobject_name = related_sobject['name']
            task_process = task_sobject['context']
            episode_description = related_sobject['description']
            
            message_text = u'<i>{0}:</i>  <b>#{1}</b><i>Исполнитель:</i>  {2}<i>Процесс:</i>  <b>#{3}</b><i>Описание:</i>  {4}'.format(status, related_sobject_name, assigned_user_title, task_process ,episode_description)
    
        if input['mode'] == 'update':
            status = input['update_data'].get('status')
            if not status:
                status = input['sobject']['status']
                
            task_sobject = input['sobject']
            
            filters = [('code', task_sobject['search_code'])]
            related_sobject = server.query(task_sobject['search_type'], filters, single=True)
                    
            user_telegram_login = bot.get_chat(assigned_user_chat_id)['username']
            assigned_user_title = u'{0} {1} @{2}'.format(assigned_user['first_name'], assigned_user['last_name'], user_telegram_login)
            message_text = u'<i>{0}:</i>  <b>#{1}</b><i>Исполнитель:</i>  {2}<i>Процесс:</i>  <b>#{3}</b>'.format(status, related_sobject['name'], assigned_user_title, task_sobject['context'])
    
            
        return message_text
    
    # if there is no assigned user no one will recirve messages, skip
    
    if assigned_user and telegram_notifications_enabled:
        message_text = generate_task_info_message(input, assigned_user)
        result_status = input['update_data'].get('status')
        if not result_status:
            result_status = input['sobject'].get('status')
        send_to_user, send_to_supervisor = sending_guess(result_status)
    else:
        message_text = None
    
    
    if message_text and assigned_user:
        
        for super_visor in SUPERVISORS_IDS:
            # sendging message to supervisor
            if super_visor and send_to_supervisor:
                try:
                    if STATUS == ON_REVIEW:
                        TASK_CODE = input['search_code']
                        
                        accept_keyboard = telegram.InlineKeyboardButton(text='Принять', callback_data='tasks_handler:accept:{0}'.format(TASK_CODE))
                        reject_keyboard = telegram.InlineKeyboardButton(text='Отклонить', callback_data='tasks_handler:reject:{0}'.format(TASK_CODE))
                        revise_keyboard = telegram.InlineKeyboardButton(text='Пересмотр', callback_data='tasks_handler:revise:{0}'.format(TASK_CODE))
        
                        custom_keyboard = [[accept_keyboard], [reject_keyboard, revise_keyboard]]
        
                        reply_markup = telegram.InlineKeyboardMarkup(custom_keyboard)
        
                        message = bot.send_message(chat_id=super_visor, parse_mode=telegram.ParseMode.HTML, text=message_text, reply_markup=reply_markup)
                    else:
                        message = bot.send_message(chat_id=super_visor, parse_mode=telegram.ParseMode.HTML, text=message_text)
                except:
                    mess = 'Message not sent to {0}'.format(super_visor)
                    bot.send_message(chat_id=CHECK_ID, text=mess)
    
        # sendging message to assigned user
        if assigned_user_chat_id and send_to_user:
            if assigned_user_chat_id != supervisor_user_chat_id:
                try:
                    bot.send_message(chat_id=assigned_user_chat_id, parse_mode=telegram.ParseMode.HTML, text=message_text)
                except:
                    mess = 'Message not sent to {0}'.format(assigned_user_chat_id)
                    bot.send_message(chat_id=CHECK_ID, text=mess)""")
