tree_widget2.addTopLevelItem(QtGui.QTreeWidgetItem())
tree_widget2.addTopLevelItem(QtGui.QTreeWidgetItem())
tree_widget2.addTopLevelItem(QtGui.QTreeWidgetItem())

lay.addWidget(tree_widget)
