insert.set_value('code', """CUSTOM_SCRIPT00091""")
insert.set_value('folder', """dev""")
insert.set_value('language', """python""")
insert.set_value('script', """
# skey://cg/assets?project=niki_friends&code=ASSETS00051
#skey://cg/texture?project=niki_friends&code=TEXTURE00077
#skey://sthpw/snapshot?code=SNAPSHOT00034978

from pyasm.search import Search

server.set_project('niki_friends')

ASSET_CODE = 'ASSETS00051'


search = Search('cg/assets', project_code='niki_friends')
search.add_filter('code', ASSET_CODE)

assets_niki = search.get_sobjects()



search = Search('cg/texture', project_code='niki_friends')
search.add_relationship_filter(assets_niki[0])

textures_niki = search.get_sobjects()


for texture in textures_niki:
    sub_type = texture.get_value('sub_type')
    trimmed = sub_type.replace('sourceimages', '')
    texture.set_value('sub_type', trimmed)
    texture.commit(triggers=False)


search = Search('sthpw/snapshot')
search.add_relationship_filters(textures_niki)

textures_snapshots = search.get_sobjects()

for snapshot in textures_snapshots:
    snapshot_files = snapshot.get_all_file_objects()
    for fl in snapshot_files:

        checkin_dir = fl.get_value('checkin_dir')
        parts = list(checkin_dir.rpartition('sourceimages'))
        parts.remove('sourceimages')
        checkin_dir_tr = ''.join(parts)
        
        
        relative_dir = fl.get_value('relative_dir')
        parts = list(relative_dir.rpartition('sourceimages'))
        parts.remove('sourceimages')
        relative_dir_tr = ''.join(parts)

        fl.set_value('checkin_dir', checkin_dir_tr)
        fl.set_value('relative_dir', relative_dir_tr)
        
        fl.commit(triggers=False)
        

return 'DONE'""")
