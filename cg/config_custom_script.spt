insert.set_value('script', """sobject = input['sobject'].get_value
snapshot = input['snapshot'].get_value

file_object = None

if input['file_object']:
    file_object = input['file_object'].get_value

parent = input['sobject'].get_parent()

if parent:
    parent = parent.get_value
else:
    parent = sobject.get_value

ext = input.get('ext')

#publish_dir_expr = "{project.code}/episodes/{sobject.name}/renders{@CASE( @GET(file.type) == 'playblast', '/'+'__preview', @GET(file.type) == 'web',  '/'+'__preview/web', @GET(file.type) == 'icon', '/'+'__preview/icon')}"
#dir_expr = "{project.code}/episodes/{sobject.name}/{snapshot.process}{@CASE( @GET(file.type) == 'playblast', '/'+'__preview', @GET(file.type) == 'web',  '/'+'__preview/web', @GET(file.type) == 'icon', '/'+'__preview/icon')}"

#context_version_expr = "{sobject.name}_{basefile}_{snapshot.context}_v{version}.{ext}"

#version_expr = "{parent.name}_{sobject.name}_{snapshot.context}_v{version}{@IF(@GET(file.type) == 'playblast', '_playblast' ))}.{ext}"

#versionless_expr = "{parent.name}_{sobject.name}_{snapshot.context}{@IF(@GET(file.type) == 'playblast', '_playblast' ))}.{ext}"


version = int(snapshot('version'))
if version in [-1, 0]:
    version = None
    versions_path = ''
else:
    versions_path = '/versions'

if file_object:
    if ext:
        
        if file_object('type') == 'playblast':
            file_type = '_playblast'
        else:
            file_type = ''
        
        if version:
            if snapshot('process') == 'publish':
                if snapshot('context') == 'publish':
                    full_name = u'{0}_{1}_v{2:03d}{3}{4}'.format(parent('name'), sobject('name'), version, file_type, ext)
                else:
                    full_name = u'{0}_{1}_{2}_v{3:03d}{4}{5}'.format(parent('name'), sobject('name'), snapshot('context').split('/')[1], version, file_type, ext)
            else:
                full_name = u'{0}_{1}_{2}_v{3:03d}{4}{5}'.format(parent('name'), sobject('name'), snapshot('context'), version, file_type, ext)
    
            
        else:
            if snapshot('process') == 'publish':
                if snapshot('context') == 'publish':
                    full_name = u'{0}_{1}{2}{3}'.format(parent('name'), sobject('name'), file_type, ext)
                else:
                    full_name = u'{0}_{1}_{2}{3}{4}'.format(parent('name'), sobject('name'), snapshot('context').split('/')[1], file_type, ext)
            else:
                full_name = u'{0}_{1}_{2}{3}{4}'.format(parent('name'), sobject('name'), snapshot('context'), file_type, ext)
            
            
        
        return full_name.replace('/', '_')
    else:
        if file_object('type') == 'web':
            preview_path = u'/__preview/web'
        elif file_object('type') == 'icon':
            preview_path = u'/__preview/icon'
        elif file_object('type') == 'playblast':
            preview_path = u'/__preview'
        else:
            preview_path = u''
        
        if snapshot('process') == 'publish':
            full_dir = u'niki_friends/episodes/{0}{1}{2}'.format(parent('name'), versions_path, preview_path)
        else:
            full_dir = u'niki_friends/episodes/{0}/{1}{2}{3}'.format(parent('name'), snapshot('process'), versions_path, preview_path)
        
        return full_dir""")
