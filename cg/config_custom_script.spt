insert = SearchType.create('config/custom_script')
insert.set_value('code', """CUSTOM_SCRIPT00073""")
insert.set_value('folder', """dev""")
insert.set_value('language', """python""")
insert.set_value('script', """import json
import codecs
import os
import collections
from pyasm.search import Search


server.set_project('dolly3d')

assets_category_search = Search('cg/assets_category')

assets_category_sobjects = assets_category_search.get_sobjects()

assets_category_dict = collections.OrderedDict()


def prettify_text(text, first_letter=False):
    if text:
        if first_letter:
            text = text.replace('_', ' ').split(' ')
            final_text = []
            for word in text:
                word = word[:1].upper() + word[1:]
                final_text.append(word)
            return u' '.join(final_text)
        else:
            return text.replace('_', ' ').title()


def generate_content(assets_sobjects):
    content = []
    
    for asset_sobject in assets_sobjects:
        files = None
        
        snapshot_search = Search('sthpw/snapshot')
        snapshot_search.add_sobject_filter(asset_sobject)
        snapshot_search.add_filter('process', 'publish')
        snapshot_search.add_filter('version', -1)

        snapshot_sobject = snapshot_search.get_sobject()
        if snapshot_sobject:
            files = snapshot_sobject.get_file_by_type('playblast')

        if files:
            pic = '![](/assets/{0}/{1})'.format(files.get_value('relative_dir'), files.get_full_file_name())
            asset_info = '###{0}{2}{1}'.format(prettify_text(asset_sobject.get_value('name')), asset_sobject.get_value('description'), pic)
        else:
            asset_info = '###{0}{1}'.format(prettify_text(asset_sobject.get_value('name')), asset_sobject.get_value('description'))
        
        content.append(asset_info)
    
    return ''.join(content)
    

for assets_category in assets_category_sobjects:
    
    assets_search = Search('cg/assets')
    assets_search.add_filter('assets_category_code', assets_category.get_code())

    assets_sobjects = assets_search.get_sobjects()

    assets_category_dict[assets_category.get_code()] = assets_sobjects


    docs_path = '/opt/tactic/dolly_docs/docs/assets'
    md_file_path = '{0}/{1}.md'.format(docs_path, assets_category.get_code().split('/')[-1])

    content = generate_content(assets_sobjects)
    
    if os.path.exists(docs_path):
        with codecs.open(md_file_path, 'w', 'utf-8') as md_file:
            md_file.write(content)
    else:
        os.makedirs(docs_path)
        with codecs.open(md_file_path, 'w', 'utf-8') as md_file:
            md_file.write(content)

    md_file.close()


return json.dumps(str(assets_category_dict))
""")
