insert = SearchType.create('config/custom_script')
insert.set_value('code', """CUSTOM_SCRIPT00075""")
insert.set_value('folder', """telegram""")
insert.set_value('language', """python""")
insert.set_value('script', """import json
from dateutil import parser as date_parser
from pprint import pformat
import telegram


from pyasm.search import Search, SearchType
from pyasm.biz import Pipeline
from pyasm.prod.biz import ProdSetting


server.set_project('niki_friends')


telegram_notifications_enabled = ProdSetting.get_value_by_key('telegram_notifications_enabled')

if telegram_notifications_enabled:
    telegram_notifications_enabled = json.loads(telegram_notifications_enabled)

# Init bot chat
bot = telegram.Bot(token='690330253:AAFdFCBJSj_bz7digLAHa4DUIFNe4PlQ6vA')


# CONSTANTS

# check id chat and supervisors
CHECK_ID = 479912061
SUPERVISORS_IDS = [380043516, 479912061]
#SUPERVISORS_IDS = [479912061]

#mess = pformat(input)
#bot.send_message(chat_id=CHECK_ID, text=mess, parse_mode=telegram.ParseMode.HTML)

# Current domain
DOMAIN_URL = 'http://tactic.bravartstudio.com'

# STATUSES
READY = u'Готов к работе'
ASSIGNED = u'Назначен'
IN_PROGRESS = u'В работе'
NEED_HELP = u'Нужна помощь'
PAUSE = u'На паузе'
REVISE = u'Пересмотр'
DECLINED = u'Отклонен'
ON_REVIEW = u'На проверке'
APPROVED = u'Принят'
PAYED = u'Оплачен'

NEW_STATUS = input['update_data'].get('status')
CURRENT_PROCESS = input['sobject'].get('process')


if input['sobject'].get('search_code') in ['SCENES00195', 'SCENES00129', 'SCENES00196', 'SCENES00213', 'SCENES00214', 'SCENES00215', 'SCENES00223', 'SCENES00225', 'SCENES00226', 'SCENES00227', 'SCENES00228']:
    telegram_notifications_enabled = False


def get_task_due_string(timestamp):
    timestamp = date_parser.parse(timestamp)
    
    return timestamp.strftime("%d %b, %Y")


def approve_assets(parent_sobject):
    
    PROCESS = 'assets'
    STATUS = 'Approved'
    
    search_task = Search('sthpw/task')
    search_task.add_sobject_filter(parent_sobject)
    
    search_task.add_filter('process', PROCESS)
    
    task = search_task.get_sobject()
    
    if task:
        task.set_value('status', STATUS)
    else:
        task = SearchType.create('sthpw/task')
        
        task.set_value('process', PROCESS)
        task.set_value('context', PROCESS)
        task.set_value('status', STATUS)
    
    task.set_parent(parent_sobject)
    
    task.commit()


def sending_guess(update_data):
    send_to_user = False
    send_to_supervisor = False
    mass_sending = False
    
    status = update_data.get('status')
    
    
    if status in [ASSIGNED, IN_PROGRESS, NEED_HELP, PAUSE, REVISE, DECLINED, ON_REVIEW, APPROVED, PAYED]:
        send_to_user = True

    if status in [ASSIGNED, IN_PROGRESS, NEED_HELP, PAUSE, REVISE, DECLINED, ON_REVIEW, APPROVED, PAYED]:
        send_to_supervisor = True
    
    if status == READY:
        mass_sending = True

    description = update_data.get('description')
    
    if description:
        send_to_supervisor = True
        send_to_user = True    
    
    assignee = update_data.get('assigned')
    
    if assignee:
        send_to_supervisor = True
        send_to_user = True    

    bid_end_date = update_data.get('bid_end_date')
    
    if bid_end_date:
        send_to_supervisor = True
        send_to_user = True    


    return send_to_user, send_to_supervisor, mass_sending


def get_movie_snapshot(s_code, process):
    movie_web_path = None

    filters = [
        ('search_code', s_code),
        ('process', process),
        ('project_code', 'dolly3d')
    ]
    
    snapshot = server.query_snapshots(filters, single=True, include_web_paths_dict=True)

    if snapshot:
        movie_web_path = snapshot[0]['__web_paths_dict__'].get('movie')
        if not movie_web_path:
            main_web_path = snapshot[0]['__web_paths_dict__'].get('main')
            if main_web_path:
                movie_web_path = main_web_path[0]

    return movie_web_path


def get_users_from_task_sobj(sobj):
    assigned_user = sobj.get('assigned')
    if not assigned_user:
        assigned_user = input['update_data'].get('assigned')

    supervisor_user = sobj.get('supervisor')
    
    if assigned_user:
        assigned_user = server.eval("@SOBJECT(sthpw/login['login','{0}'])".format(assigned_user))[0]
    if supervisor_user:
        supervisor_user = server.eval("@SOBJECT(sthpw/login['login','{0}'])".format(supervisor_user))[0]
    
    return assigned_user, supervisor_user


def get_script_writer_from_sobject(task_sobject):
    
    # first we getting parent sobject of current task
    filters = [('code', task_sobject['search_code'])]
    parent_sobject = server.query(task_sobject['search_type'], filters, single=True, return_sobjects=True)

    # now we getting script tasks, to get script writer id
    PROCESS = 'script'

    search_task = Search('sthpw/task')
    search_task.add_sobject_filter(parent_sobject)
    
    search_task.add_filter('process', PROCESS)
    
    task = search_task.get_sobject()

    script_writer_user = None
    if task:
        script_writer_user = task.get_value('assigned')
    
    if script_writer_user:
        script_writer_user = server.eval("@SOBJECT(sthpw/login['login','{0}'])".format(script_writer_user))[0]

    return script_writer_user


