def do_mass_sending():
    
    task_sobject = input['sobject']
    TASK_CODE = input['search_code']

    filters = [('code', task_sobject['search_code'])]
    related_sobject = server.query(task_sobject['search_type'], filters, single=True, return_sobjects=True)

    # Approve assets for animation    
    if task_sobject.get('process') in ['layout', 'animation']:
        approve_assets(related_sobject)

    filters = [('code', TASK_CODE)]
    task_sobject_object = server.query('sthpw/task', filters, single=True, return_sobjects=True)

    
    # for that, we getting assigned groups of logins
    
    parent_sobject_pipeline = Pipeline.get_by_code(related_sobject.get_value('pipeline_code'))
    
    current_process = parent_sobject_pipeline.get_process(task_sobject.get('process'))
    
    assigned_login_group = current_process.get_attribute('assigned_login_group')
    
    users_list = []
    
    # we sending ready to work only for user assigned (if he already assigned)
    already_assigned = task_sobject.get('assigned')
    if already_assigned:
        login_search = Search('sthpw/login')
        login_search.add_filter('login', already_assigned)
        
        login_sobject = login_search.get_sobject()

        users_list.append(login_sobject)
        
    else:
        logins = Search.eval("@SOBJECT(sthpw/login_in_group['login_group','{0}'].sthpw/login)".format(assigned_login_group))
        for login in logins:
            if login.get_value('phone_number'):
                users_list.append(login)
            
    
    
    # when we have list with logins we can generate mass message
    def generate_message(parent_sobject, current_process):
        message_con = []
        
        episode_script = parent_sobject.get_value('script')
        episode_name = parent_sobject.get_value('name')
        

        episode_name_dashed = episode_name.replace(' ', '_')

        message_con.append('📢 Готов к работе')
        message_con.append('Процесс: #{0}'.format(current_process))
        message_con.append('<b> #{0}</b>'.format(episode_name_dashed))
        message_con.append('<a href="{0}">Сценарий</a>'.format(episode_script))

        if current_process in ['layout', 'animation']:
            free_episodes = '{0}/tactic/dolly3d/link/free_to_take_episodes'.format(DOMAIN_URL)
            message_con.append('<a href="{0}">Весь список доступных</a>'.format(free_episodes))        

        if current_process == 'light':
            free_episodes = '{0}/dolly3d/link/ready_to_light_episodes'.format(DOMAIN_URL)
            message_con.append('<a href="{0}">Весь список доступных</a>'.format(free_episodes))        
        
        parent_description = parent_sobject.get_value('description')
        if parent_description:
            message_con.append(u'Описание:  <b>{0}</b>'.format(parent_description))
        
        message_text = u''.join(message_con)
        
        return message_text

    
    take_keyboard = telegram.InlineKeyboardButton(text='☑️ Назначить на себя', callback_data='tasks_handler:take:{0}'.format(TASK_CODE))
    custom_keyboard = [[take_keyboard]]
    reply_markup = telegram.InlineKeyboardMarkup(custom_keyboard)

    #message = bot.send_message(chat_id=CHECK_ID, parse_mode=telegram.ParseMode.HTML, text=generate_message(related_sobject, task_sobject.get('process')), reply_markup=reply_markup)

    #bot.send_message(chat_id=CHECK_ID, text=str(task_sobject_object))
    

    # begin mass sending
    message_ids = []
    chat_ids = []

    data_dict = {'message_id': message_ids, 'chat_id': chat_ids}

    for user in users_list:
        
        message = generate_message(related_sobject, task_sobject.get('process'))
        
        if user.get_value('phone_number'):
            try:
                message = bot.send_message(chat_id=user.get_value('phone_number'), parse_mode=telegram.ParseMode.HTML, text=message, reply_markup=reply_markup)
                
                message_ids.append(message['message_id'])
                chat_ids.append(message['chat_id'])

            except:
                mess = 'Message not sent to {0}'.format(user.get_value('login'))
                bot.send_message(chat_id=CHECK_ID, text=mess)

    # extend list with Supervisors
    for super_visor in SUPERVISORS_IDS:
        message = generate_message(related_sobject, task_sobject.get('process'))
        try:
            message = bot.send_message(chat_id=super_visor, parse_mode=telegram.ParseMode.HTML, text=message)
            
            message_ids.append(message['message_id'])
            chat_ids.append(message['chat_id'])

        except:
            mess = 'Message not sent to {0}'.format(user.get_value('login'))
            bot.send_message(chat_id=CHECK_ID, text=mess)
    
    task_sobject_object.set_json_value('data', data_dict)
    task_sobject_object.commit(triggers=False)


def generate_task_info_message(input, assigned_user):
    message_text = None

    if input['mode'] == 'insert':
        status = input['update_data'].get('status')

        task_sobject = input['sobject']
        
        filters = [('code', task_sobject['search_code'])]
        related_sobject = server.query(task_sobject['search_type'], filters, single=True)

        #user_telegram_login = bot.get_chat(assigned_user_chat_id)['username']
        
        #if user_telegram_login:
        #    assigned_user_title = u'{0} @{1}'.format(assigned_user['display_name'], user_telegram_login)
        #else:
        assigned_user_title = u'{0}'.format(assigned_user['display_name'])

        related_sobject_name = related_sobject['name']
        task_process = task_sobject['context']
        task_description = task_sobject['description']
        parent_description = related_sobject['description']
        
        related_sobject_name = related_sobject_name.replace(' ', '_')
        
        message_con = []
        if status:
            status = status.replace('/', '_').replace(' ', '_')
            message_con.append(u'☑️ <b>Новая задача: #{0}</b>  <b>#{1}</b>'.format(status, related_sobject_name))
        else:
            message_con.append(u'☑️ <i>Новая задача:</i>  <b>#{0}</b>'.format(related_sobject_name))
        if assigned_user_title:
            message_con.append(u'Исполнитель:  <a href="tg://user?id={1}">{0}</a>'.format(assigned_user_title, assigned_user_chat_id))
        if task_process:
            message_con.append(u'Процесс:  <i>#{0}</i>'.format(task_process))
        if task_description:
            message_con.append(u'Описание задачи:  <b>{0}</b>'.format(task_description))
        elif parent_description:
            message_con.append(u'Информация об эпизоде:  <b>{0}</b>'.format(parent_description))
        
        message_text = u''.join(message_con)

    if input['mode'] == 'update':
        status = input['update_data'].get('status')
        earlier_status = input['prev_data'].get('status')
        
        task_description = input['update_data'].get('description')
        
        task_sobject = input['sobject']
        
        # Getting Task description
        description_updated = False
        if input['update_data'].get('description'):
            task_due_date = input['update_data'].get('description')
            description_updated = True
        else:
            task_due_date = task_sobject.get('description')

        
        # Getting Task End Date
        task_end_date_updated = False
        if input['update_data'].get('bid_end_date'):
            task_due_date = input['update_data'].get('bid_end_date')
            task_end_date_updated = True
        else:
            task_due_date = task_sobject.get('bid_end_date')
        
        filters = [('code', task_sobject['search_code'])]
        related_sobject = server.query(task_sobject['search_type'], filters, single=True)

        #user_telegram_login = bot.get_chat(assigned_user_chat_id)['username']
        #if user_telegram_login:
        #    assigned_user_title = u'{0} @{1}'.format(assigned_user['display_name'], user_telegram_login)
        #else:
        assigned_user_title = u'{0}'.format(assigned_user['display_name'])

        related_sobject_name = related_sobject['name']
        task_process = task_sobject['context']
        
        related_sobject_name = related_sobject_name.replace(' ', '_')
        
        message_con = []
        if status:
            dash_status = status.replace('/', '_').replace(' ', '_')
            if earlier_status:
                dash_earlier_status = earlier_status.replace('/', '_').replace(' ', '_')
            else:
                dash_earlier_status = 'Без_статуса'

            status_icon = '📬'
            if status == APPROVED:
                status_icon = '✅'
            if status == REVISE:
                status_icon = '⚠️'
            if status == DECLINED:
                status_icon = '❌'
            if status == ASSIGNED:
                status_icon = '☑️'
            if status == IN_PROGRESS:
                status_icon = '🛠'
            if status == NEED_HELP:
                status_icon = '❕'
            if status == PAUSE:
                status_icon = '⏸'
            if status == ON_REVIEW:
                status_icon = '❔'
            if status == PAYED:
                status_icon = '💸'

            message_con.append(u'{0} #<i>{1} ← #{2}:</i>  <b>#{3}</b>'.format(status_icon, dash_status, dash_earlier_status, related_sobject_name))
        else:
            message_con.append(u'📝 <i>Задача изменена:</i>  <b>#{0}</b>'.format(related_sobject_name))
        if assigned_user_title:
            message_con.append(u'Исполнитель:  <a href="tg://user?id={1}">{0}</a>'.format(assigned_user_title, assigned_user_chat_id))
        if task_process:
            message_con.append(u'Процесс:  <i>#{0}</i>'.format(task_process))

        
        if status == ON_REVIEW:

        # *** ANIMATION ON REVIEW ***
            if CURRENT_PROCESS in ['animation', 'layout']:
                playblast_link_snapshot = get_movie_snapshot(task_sobject['search_code'], CURRENT_PROCESS)

                if playblast_link_snapshot:
                    playblast_link = u'{0}{1}'.format(DOMAIN_URL, playblast_link_snapshot)
                    message_con.append(u'<a href="{0}">Плейбласт</a>'.format(playblast_link))
        # *** ANIMATION ON REVIEW ***
        
        # *** LIGHTING ON REVIEW ***
            if CURRENT_PROCESS == 'light':
                gallery_link = '{0}/tactic/dolly3d/episodes/{1}'.format(DOMAIN_URL, related_sobject['code'])
                message_con.append(u'<a href="{0}">Галерея</a>'.format(gallery_link))
        # *** LIGHTING ON REVIEW ***

        # *** SCRIPT ON REVIEW ***
            if CURRENT_PROCESS == 'script':
                script_link = related_sobject.get('script')
                if script_link:
                    message_con.append(u'<a href="{0}">Сценарий</a>'.format(script_link))
        # *** SCRIPT ON REVIEW ***

        if task_description:
            if description_updated:
                message_con.append(u'✏️ Изменилось описание:  <b>{0}</b>'.format(task_description))
            else:
                message_con.append(u'Описание задачи:  <b>{0}</b>'.format(task_description))
        
        if task_due_date:
            if task_end_date_updated:
                message_con.append(u'✏️ Измнилась дата сдачи:  <b>{0}</b>'.format(get_task_due_string(task_due_date)))
            else:
                message_con.append(u'Предполагаемая дата сдачи:  <b>{0}</b>'.format(get_task_due_string(task_due_date)))
    
        message_text = u''.join(message_con)    

    return message_text


if telegram_notifications_enabled:
    
    # if there is no assigned user no one will recirve messages, skip
    
    if assigned_user:
        message_text = generate_task_info_message(input, assigned_user)
    else:
        message_text = None

    send_to_user, send_to_supervisor, mass_sending = sending_guess(input['update_data'])


    if mass_sending:
        do_mass_sending()


    if message_text:
        
        for super_visor in SUPERVISORS_IDS:
            # sendging message to supervisor
            if super_visor and send_to_supervisor and not mass_sending:
                try:
                    if NEW_STATUS == ON_REVIEW:
                        TASK_CODE = input['search_code']
                        
                        accept_keyboard = telegram.InlineKeyboardButton(text='✅ Принять', callback_data='tasks_handler:accept:{0}'.format(TASK_CODE))
                        reject_keyboard = telegram.InlineKeyboardButton(text='❌ Отклонить', callback_data='tasks_handler:reject:{0}'.format(TASK_CODE))
                        revise_keyboard = telegram.InlineKeyboardButton(text='⚠️ Пересмотр', callback_data='tasks_handler:revise:{0}'.format(TASK_CODE))
        
                        custom_keyboard = [[accept_keyboard], [reject_keyboard, revise_keyboard]]
        
                        reply_markup = telegram.InlineKeyboardMarkup(custom_keyboard)
        
                        message = bot.send_message(chat_id=super_visor, parse_mode=telegram.ParseMode.HTML, text=message_text, reply_markup=reply_markup)
                    else:
                        message = bot.send_message(chat_id=super_visor, parse_mode=telegram.ParseMode.HTML, text=message_text)
                except:
                    mess = 'Message not sent to {0}'.format(super_visor)
                    bot.send_message(chat_id=CHECK_ID, text=mess)

        # sendging message to scriptwriters related to sobject
        if script_writer_user_chat_id:
            try:
                bot.send_message(chat_id=script_writer_user_chat_id, parse_mode=telegram.ParseMode.HTML, text=message_text)
            except:
                mess = 'Message not sent to {0}'.format(script_writer_user_chat_id)
                bot.send_message(chat_id=CHECK_ID, text=mess)
            

        # sendging message to assigned user
        if assigned_user_chat_id and send_to_user and not mass_sending:
            try:
                bot.send_message(chat_id=assigned_user_chat_id, parse_mode=telegram.ParseMode.HTML, text=message_text)
            except:
                mess = 'Message not sent to {0}'.format(assigned_user_chat_id)
                bot.send_message(chat_id=CHECK_ID, text=mess)

# CLEANING UP ALL CHATS AFTER ASSIGNING LOGIN

have_ids = False
have_update_data = False

#current_task_sobject = server.eval(u"@SOBJECT(sthpw/task['code', '{0}'])".format(input['search_code']))
telegram_data = input['update_data'].get('data')
if not telegram_data:
    telegram_data = input['sobject'].get('data')

