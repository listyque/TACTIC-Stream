gf.add_item_to_tree(tree_widget, QtGui.QTreeWidgetItem(), shuffle_widget)
gf.add_item_to_tree(tree_widget2, QtGui.QTreeWidgetItem(), shuffle_widget)

gf.add_item_to_tree(tree_widget, QtGui.QTreeWidgetItem(), handoff_widget)

