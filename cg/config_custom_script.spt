# Searching for current assigned user
assigned_login = input['update_data'].get('assigned')

if not assigned_login:
    assigned_login = input['sobject'].get('assigned')


if assigned_login and have_update_data and have_ids:

    filters = [('login', assigned_login)]
    current_user = server.query('sthpw/login', filters)

    assigned_user_chat_id = current_user[0].get('phone_number')

    assigned_user_title = u'<a href="tg://user?id={1}">{0}</a>'.format(current_user[0]['display_name'], assigned_user_chat_id)
    
    already_assigned = False
    
    # Getting message sent to users
    try:
        reply_markup = telegram.InlineKeyboardMarkup([])
        message = bot.edit_message_reply_markup(chat_id=telegram_ids['chat_id'][0], message_id=telegram_ids['message_id'][0], reply_markup=reply_markup)
    
        original_message = message.text_html
    except:
        mess = 'Original message is already was edited'
        bot.send_message(chat_id=CHECK_ID, text=mess)
        original_message = u'Не удалось получить оригинальное сообщение!'
        already_assigned = True
    
    new_message = text=u'👤 Данная задача была назначена на: {0}Исходное сообщение:{1}'.format(assigned_user_title, original_message)
    
    # UPDATE ALL CHATS MESSAGES TO TELL WHO TOOK EPISODE
    
    if not already_assigned:
        for i, chat_id in enumerate(telegram_ids['chat_id']):
            try:
                bot.edit_message_text(text=new_message, chat_id=int(chat_id), message_id=int(telegram_ids['message_id'][i]), parse_mode=telegram.ParseMode.HTML)
            except:
                mess = 'Message not sent to {0}'.format(assigned_user_title)
                bot.send_message(chat_id=CHECK_ID, text=mess)
    
# UPDATE ALL CHATS MESSAGES TO TELL WHO TOOK EPISODE
