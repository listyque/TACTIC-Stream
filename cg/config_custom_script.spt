insert.set_value('language', """python""")
insert.set_value('script', """import telegram

bot = telegram.Bot(token='690330253:AAFdFCBJSj_bz7digLAHa4DUIFNe4PlQ6vA')

#return str(telegram.InlineKeyboardMarkup)

#***LOGGING

from pprint import pformat

assigned_user_chat_id = 479912061
supervisor_user_chat_id = 380043516

mess = '<i>На проверке:</i><b> Ep128</b><i>Процесс:</i> <b> light</b><a href="http://dolly3d.tk/tactic/dolly3d/episodes/SCENES00099">Галерея</a>'
#message = bot.send_message(chat_id=assigned_user_chat_id, parse_mode=telegram.ParseMode.HTML, text=mess)


promo_keyboard = telegram.InlineKeyboardButton(text="Принять", callback_data="update_taxi")
promo_keyboard2 = telegram.InlineKeyboardButton(text="Отклонить", callback_data="update_taxi")

custom_keyboard = [[promo_keyboard], [promo_keyboard2]]

reply_markup = telegram.InlineKeyboardMarkup(custom_keyboard)

bot.send_message(chat_id=assigned_user_chat_id, parse_mode=telegram.ParseMode.HTML, text=mess, reply_markup=reply_markup) 

return 'Assa'""")
