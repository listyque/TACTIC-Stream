insert.set_value('language', """python""")
insert.set_value('script', """from pyasm.search import Search, SearchKey

# adding initial task for added Episode

server.set_project(server.get_project())

search_code = input['sobject'].get('search_code')
search_type = input['sobject'].get('search_type')

search_key = server.build_search_key(search_type, search_code)


def get_uncomplete_assets(search_code):
    
    assets = Search.eval("@SOBJECT(cg/scenes['code', '{0}'].cg/assets)".format(search_code))
    publish_tasks = Search.eval("@SOBJECT(cg/scenes['code', '{0}'].cg/assets.sthpw/task['process', 'publish'])".format(search_code))
    if len(publish_tasks) == len(assets):
        return publish_tasks
    else:
        return 'none'

if search_key and search_type == 'cg/scenes?project={}'.format(server.get_project()):
    
    related_sobject = SearchKey.get_by_search_key(search_key)
    current_pipeline = related_sobject.get_value('pipeline_code')

    
    if current_pipeline == 'cg/songs':

        server.add_initial_tasks(search_key, processes=['arrangement'])

    elif current_pipeline in ['cg/scenes', 'cg/dialog']:

        # HERE IS THE CHECK FOR ASSETS IF THEY ARE ALL READY
        publish_tasks = get_uncomplete_assets(search_code)
    
        have_uncomplete_task = False
            # if we not found same count of pubslish tasks as the count of assets we go uncomplete!
        if publish_tasks == 'none':
            have_uncomplete_task = True
        else:
            for task in publish_tasks:
                if task.get_value('status') != u'Опубликован':
                    have_uncomplete_task = True
                    break
        
        if not have_uncomplete_task:
            server.add_initial_tasks(search_key, processes=['layout'])""")
