insert.set_value('folder', """tasks""")
insert.set_value('language', """python""")
insert.set_value('script', """from pyasm.search import Search, SearchKey
from pyasm.biz import Task
from pyasm.common import SPTDate
# setting up start date for the tasks if it is not set

server.set_project(server.get_project())

search_code = input['sobject'].get('search_code')
search_type = input['sobject'].get('search_type')

search_key = server.build_search_key(search_type, search_code)

if search_key and search_type == 'cg/scenes?project={}'.format(server.get_project()):

    assigned_user = input['sobject'].get('assigned')    
    
    related_sobject = SearchKey.get_by_search_key(search_key)
    current_pipeline = related_sobject.get_value('pipeline_code')

    task_search_key = server.build_search_key('sthpw/task', input['sobject']['code'])
    related_task_sobject = SearchKey.get_by_search_key(task_search_key)

    curret_status = input['sobject'].get('status')
    curret_process = input['sobject'].get('process')

    if curret_status == 'В работе':

        start_date = SPTDate.today()
        start_date_str = start_date.strftime("%Y-%m-%d")

        related_task_sobject.set_value('bid_start_date', start_date_str)
        related_task_sobject.commit(triggers=False)""")
