do_not_send_anything = True
'''


CHECK_ID = 479912061

if telegram_notifications_enabled:

    def get_user_from_task_sobj(sobj):
        assigned_user = sobj.get('assigned')
        
        if assigned_user:
            assigned_user = server.eval("@SOBJECT(sthpw/login['login','{0}'])".format(assigned_user), single=True)
        
        return assigned_user
    
    assigned_user = get_user_from_task_sobj(input['sobject'])
    
    assigned_user_chat_id = None
    if assigned_user:
        assigned_user_chat_id = assigned_user['phone_number']
    
    def generate_task_info_message(input, assigned_user):
        message_text = None
    
        if input['mode'] == 'insert':
            status = input['update_data'].get('status')

            task_sobject = input['sobject']
            
            filters = [('code', task_sobject['search_code'])]
            related_sobject = server.query(task_sobject['search_type'], filters, single=True)

            user_telegram_login = bot.get_chat(assigned_user_chat_id)['username']
            if user_telegram_login:
                assigned_user_title = u'{0} {1} @{2}'.format(assigned_user['first_name'], assigned_user['last_name'], user_telegram_login)
            else:
                assigned_user_title = u'{0} {1}'.format(assigned_user['first_name'], assigned_user['last_name'])
    
            related_sobject_name = related_sobject['name']
            task_process = task_sobject['context']
            task_description = task_sobject['description']
            parent_description = related_sobject['description']
            
            message_con = []
            if status:
                status = status.replace('/', '_').replace(' ', '_')
                message_con.append(u'<i>Новая задача: #{0}:</i>  <b>#{1}</b>'.format(status, related_sobject_name))
            else:
                message_con.append(u'<i>Новая задача:</i>  <b>#{0}</b>'.format(related_sobject_name))
            #if assigned_user_title:
            #    message_con.append(u'<i>Исполнитель:</i>  {0}'.format(assigned_user_title))
            if task_process:
                message_con.append(u'<i>Процесс:</i>  <b>#{0}</b>'.format(task_process))
            if task_description:
                message_con.append(u'<i>Описание задачи:</i>  {0}'.format(task_description))
            elif parent_description:
                message_con.append(u'<i>Описание:</i>  {0}'.format(parent_description))
            
            message_text = u''.join(message_con)
    
        if input['mode'] == 'update':
            status = input['update_data'].get('status')
            earlier_status = input['prev_data'].get('status')
            
            task_description = input['update_data'].get('description')
            earlier_task_description = input['update_data'].get('description')            
            
            task_sobject = input['sobject']
            
            filters = [('code', task_sobject['search_code'])]
            related_sobject = server.query(task_sobject['search_type'], filters, single=True)

            user_telegram_login = bot.get_chat(assigned_user_chat_id)['username']
            if user_telegram_login:
                assigned_user_title = u'{0} {1} @{2}'.format(assigned_user['first_name'], assigned_user['last_name'], user_telegram_login)
            else:
                assigned_user_title = u'{0} {1}'.format(assigned_user['first_name'], assigned_user['last_name'])
    
            related_sobject_name = related_sobject['name']
            task_process = task_sobject['context']
            
            message_con = []
            if status:
                status = status.replace('/', '_').replace(' ', '_')
                earlier_status = earlier_status.replace('/', '_').replace(' ', '_')
                message_con.append(u'<i>{0} > #{1}:</i>  <b>#{2}</b>'.format(earlier_status, status, related_sobject_name))
            else:
                message_con.append(u'<i>Задача изменена:</i>  <b>#{0}</b>'.format(related_sobject_name))
            #if assigned_user_title:
            #    message_con.append(u'<i>Исполнитель:</i>  {0}'.format(assigned_user_title))
            if task_process:
                message_con.append(u'<i>Процесс:</i>  <b>#{0}</b>'.format(task_process))
            if task_description:
                if task_description != earlier_task_description:
                    message_con.append(u'<i>Изменилось описание:</i>  {0}'.format(task_description))
                else:
                    message_con.append(u'<i>Описание задачи:</i>  {0}'.format(task_description))
            
            message_text = u''.join(message_con)    

        return message_text
    
    
    # if there is no assigned user no one will recirve messages, skip
    
    if assigned_user:
        message_text = generate_task_info_message(input, assigned_user)
    else:
        message_text = None
    
    
    if message_text:
    
        # sendging message to assigned user
        if assigned_user_chat_id:
            try:
                bot.send_message(chat_id=assigned_user_chat_id, parse_mode=telegram.ParseMode.HTML, text=message_text)
            except:
                mess = 'Message not sent to {0}'.format(assigned_user_chat_id)
                bot.send_message(chat_id=CHECK_ID, text=mess)
""")
