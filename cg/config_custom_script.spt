    def save_config(self):
        conf_dict = {}

        widgets = gf.walk_through_layouts([self.config_layout])
        gf.store_dict_values(widgets, conf_dict)

        env_write_config(conf_dict, unique_id='batch_dispatcher')

        get_configs()
        self.config_dialog.close()

    def open_episodes_context_menu(self):
        items = self.episodes_tree_widget.selectedItems()
        if items:
            widget_item = self.episodes_tree_widget.itemWidget(items[0], 0)

            self.open_item_menu(widget_item, 'episodes')

    def open_schedule_context_menu(self):
        items = self.schedule_tree_widget.selectedItems()
        if items:
            widget_item = self.schedule_tree_widget.itemWidget(items[0], 0)

            self.open_item_menu(widget_item, 'schedule')

    def open_item_menu(self, item_widget, context):
        if item_widget:
            menu = self.get_menu(item_widget, context)
            if menu:
                menu.exec_(Qt4Gui.QCursor.pos())

    def get_menu(self, overlay_item_widget, context):
        item_widget = overlay_item_widget.get_widget()
        sobject = item_widget.sobject

        menu = MenuWithLayout()
        if context == 'schedule':
            render_current = QtGui.QAction('Render Shot', self)
            exclude_current = QtGui.QAction('Exclude Shot', self)
            interrupt_current = QtGui.QAction('Interrupt Rendering', self)
            show_log = QtGui.QAction('Show Log', self)
            show_destination = QtGui.QAction('Show Destination', self)
            # copy_skey.setIcon(gf.get_icon('copy'))
            # copy_skey.triggered.connect(self.copy_search_key)

            # open_snapshot_additional = menu.addAction(open_scene, True)
            # open_snapshot_additional.clicked.connect(self.open_file_options)
            menu.addAction(render_current)
            menu.addAction(exclude_current)
            menu.addAction(interrupt_current)
            menu.addSeparator()
            menu.addAction(show_log)
            menu.addAction(show_destination)
        if context == 'episodes':
            render_all = QtGui.QAction('Render Episode', self)
            render_all.triggered.connect(lambda: self.begin_batch_by_episode(sobject))

            # restart_all = QtGui.QAction('Restart Render', self)
            # restart_all.triggered.connect(lambda: self.restart_batch_by_episode(sobject))

            interrupt_all = QtGui.QAction('Interrupt Rendering', self)

            test_render_all = QtGui.QAction('Test Render', self)
            test_render_all.triggered.connect(lambda: self.begin_test_batch_by_episode(sobject))

            ready_current = QtGui.QAction(u'Set status: Подготовлен', self)
            ready_current.triggered.connect(lambda: self.force_ep_status(u'Подготовлен', sobject))

            render_status = QtGui.QAction(u'Set status: Рендер', self)
            render_status.triggered.connect(lambda: self.force_ep_status(u'Рендер', sobject))

            schedule_current = QtGui.QAction(u'Set status: В очереди', self)
            schedule_current.triggered.connect(lambda: self.force_ep_status(u'В очереди', sobject))

            approved_current = QtGui.QAction(u'Set status: Проверен', self)
            approved_current.triggered.connect(lambda: self.force_ep_status(u'Проверен', sobject))

            menu.addAction(render_all)
            # menu.addAction(restart_all)
            menu.addSeparator()
            menu.addAction(interrupt_all)
            menu.addAction(test_render_all)
            menu.addSeparator()
            menu.addAction(ready_current)
            menu.addAction(render_status)
            menu.addAction(schedule_current)
            menu.addAction(approved_current)

        return menu

    def set_app_icon(self):
        icon = Qt4Gui.QIcon(':/ui_main/gliph/tactic_favicon.ico')
        self.setWindowIcon(icon)
        self.trayIcon.setIcon(icon)

    def create_tray_actions(self):
        self.enableNotify = QtGui.QAction('Start Scheduler', self, triggered=self.start_update_timer)
        self.disableNotify = QtGui.QAction('Stop Scheduler', self, triggered=self.stop_update_timer)
        self.showNotify = QtGui.QAction('Show Dispatcher', self, triggered=self.show)
        self.hideNotify = QtGui.QAction('Hide Dispatcher', self, triggered=self.hide)
        self.close_app_action = QtGui.QAction('Exit', self, triggered=self.close_app)

    def create_tray_icon(self):
        self.trayIconMenu = QtGui.QMenu(self)
        self.trayIconMenu.addAction(self.enableNotify)
        self.trayIconMenu.addAction(self.disableNotify)
        self.trayIconMenu.addSeparator()
        self.trayIconMenu.addAction(self.showNotify)
        self.trayIconMenu.addAction(self.hideNotify)
        self.trayIconMenu.addSeparator()
        self.trayIconMenu.addAction(self.close_app_action)

        self.trayIcon = QtGui.QSystemTrayIcon(self)
        self.trayIcon.setContextMenu(self.trayIconMenu)

    def set_status(self, stauts_text):

        self.schedule_status_label.setText(stauts_text)

    def updating(self, result):
        self.set_progress(90, 100, 'Processing updates from Server')

        self.set_status('Updating Schedule')
        self.update_task_process(result)

        if self.scheduler_status == 'started':

            self.set_progress(99, 100, 'Nothing new from Server')

            if len(self.render_queue) > 0:
                self.begin_batch_by_scheduler()
            else:
                self.start_update_timer()
        else:
            self.start_update_timer()
            self.batch_render_status = 'waiting'

            self.set_progress(99, 100, 'Got new Job from Server')

            self.set_status('Schedule on Hold')

    def update_task_process(self, sobjects):

        self.cleanup_episodes_tree_widget(sobjects)

        if len(sobjects) > 0:
            for search_key, sobject in sobjects.items():
                tasks_sobjects, info = sobject.get_tasks_sobjects(process=RENDER_PROCESS)
                episode_overlay_widget = self.episodes_overlay_widgets.get(search_key)
                if episode_overlay_widget:
                    episode_overlay_widget.set_tasks_sobjects(tasks_sobjects)
                else:
                    self.add_missing_episode_to_tree_widget(sobject, tasks_sobjects)
        else:
            self.fill_episodes_tree_widget()

    def perform_update(self, initial=False):
        # if initial:
        #     self.fill_episodes_tree_widget()

        if self.scheduler_status == 'started' or initial:

            def get_episodes_updates():
                search_type = self.stype.info['code']
                project_code = self.stype.project.get_code()
                full_search_type = tc.server_start().build_search_type(search_type, project_code=project_code)

                sobjects, info = tc.get_sobjects(full_search_type, filters=EXPR_FILTER, order_bys=['name'])
                return sobjects

            # env_inst.set_thread_pool(None, 'server_query/server_update_thread_pool')
            # env_inst.set_thread_pool(None, 'server_query/server_thread_pool')

            # query_worker = gf.get_thread_worker(
            #     get_episodes_updates,
            #     thread_pool=env_inst.get_thread_pool('server_query/server_update_thread_pool'),
            #     result_func=self.updating,
            #     error_func=self.start_update_timer
            # )
            # server_thread_pool = env_inst.get_thread_pool('server_query/server_thread_pool')

            worker = env_inst.server_pool.add_task(get_episodes_updates)

            worker.result.connect(self.updating)
            worker.error.connect(self.start_update_timer)

            # if env_inst.server_pool._thread_free == 0:
            self.stop_update_timer()
            self.set_progress(0, 100, 'Getting updates from Server')
            worker.start()

    def toggle_start_stop(self):
        if self.scheduler_status == 'stopped':
            self.start_scheduler()
        elif self.scheduler_status == 'started':
            self.stop_scheduler()

    def stop_scheduler(self):
        self.start_scheduler_button.setIcon(gf.get_icon('play', icons_set='mdi'))
        self.start_scheduler_button.setText('Start Scheduler')
        self.scheduler_status = 'stopped'
        self.stop_update_timer()
        self.episodes_tree_widget.setEnabled(True)
        self.set_status('Schedule on Hold')
        self.set_progress_indicator_off()

    def start_scheduler(self):
        self.start_scheduler_button.setIcon(gf.get_icon('stop', icons_set='mdi'))
        self.start_scheduler_button.setText('Stop Scheduler')
        self.scheduler_status = 'started'
        self.perform_update()
        self.set_status('Schedule Started')
        self.set_progress_indicator_on()

    def start_update_timer(self):
        self._updateTimer.start(self.update_interval * 1000)

    def stop_update_timer(self):
        self._updateTimer.stop()

    def add_episode_to_render_queue(self, search_key):
        if search_key not in self.render_queue:
            self.render_queue.append(search_key)

    def remove_episode_from_render_queue(self, search_key):
        if search_key in self.render_queue:
            self.render_queue.remove(search_key)

    def preprocess_episode(self, episode_widget, test_render):
        self.set_status('Preprocessing')

        if not episode_widget.is_batch_completed_connected():
            episode_widget.preprocessed.connect(lambda: self.start_batch(episode_widget, test_render, True))

        episode_widget.get_latest_assets()

    def start_batch(self, episode_widget, test_render=False, preprocessed=False):

        self.set_progress(5, 100, 'Starting Batch')

        if not preprocessed:
            self.preprocess_episode(episode_widget, test_render)
        else:
            self.set_progress(30, 100, 'Rendering Shots')
            if not episode_widget.is_batch_completed_connected():
                episode_widget.connect_batch_completed(self.episode_batch_completed)
                episode_widget.begin_batch(test_render)
            else:
                # TODO RESTART SHOTS
                episode_widget.batch_queue(test_render)
                # episode_widget.begin_batch(test_render)

    def begin_batch_by_scheduler(self):

        self.stop_scheduler()

        self.set_progress_indicator_on()

        # self.episodes_tree_widget.setEnabled(False)
        self.batch_render_status = 'working'

        # take first episode in queue
        episode_in_queue = self.episodes_overlay_widgets[self.render_queue[0]]

        self.force_ep_status(u'Рендерится', episode_in_queue.episode_sobject)

        self.shots_tree_widget_updating(episode_in_queue)

        self.start_batch(episode_in_queue)

        self.set_status('Rendering')

    def begin_batch_by_episode(self, sobject):

        self.force_ep_status(u'Рендерится', sobject)

        self.stop_scheduler()

        self.set_progress_indicator_on()

        self.batch_render_status = 'working'

        episode_overlay_widget = self.episodes_overlay_widgets.get(sobject.get_search_key())

        self.shots_tree_widget_updating(episode_overlay_widget)

        shots_overlay_widgets = episode_overlay_widget.get_shots_overlay_widgets()
        if shots_overlay_widgets:
            for shot_overlay_widget in shots_overlay_widgets.values():
                shot_overlay_widget.is_complete = False
                shot_overlay_widget.create_batch_object()

        self.start_batch(episode_overlay_widget)

        self.set_status('Rendering')

    def begin_test_batch_by_episode(self, sobject):

        self.stop_scheduler()

        self.batch_render_status = 'working'

        self.set_progress_indicator_on()

        episode_overlay_widget = self.episodes_overlay_widgets.get(sobject.get_search_key())

        self.shots_tree_widget_updating(episode_overlay_widget)

        shots_overlay_widgets = episode_overlay_widget.get_shots_overlay_widgets()
        if shots_overlay_widgets:
            for shot_overlay_widget in shots_overlay_widgets.values():
                shot_overlay_widget.is_complete = False
                shot_overlay_widget.create_batch_object()

        self.start_batch(episode_overlay_widget, test_render=True, preprocessed=False)

        self.set_status('Rendering')

    def episode_batch_completed(self, batch_result=None, episode_widget=None, test_render=False):

        self.set_progress_indicator_off()

        self.start_scheduler()

        # self.perform_update(initial=True)
        if not test_render:
            self.set_episode_status(batch_result, episode_widget)
            self.set_status('Rendering Completed',)
            # self.episodes_tree_widget.setEnabled(True)
            self.perform_update(initial=True)

    def set_episode_status(self, result, episode_widget):

        sobject = episode_widget.sobject

        tasks_sobjects, info = sobject.get_tasks_sobjects(process='render')

        for task_sobject in tasks_sobjects.values():
            if result in ['errors', 'interrupted']:
                task_sobject.set_value('status', u'Ошибки')
            else:
                task_sobject.set_value('status', u'Готов')
            task_sobject.commit()

    def force_ep_status(self, status, sobject):
        overlay_wdg = self.episodes_overlay_widgets.get(sobject.get_search_key())

        tasks_sobjects, info = sobject.get_tasks_sobjects(process='render')

        for task_sobject in tasks_sobjects.values():
            task_sobject.set_value('status', status)
            task_sobject.commit()

        overlay_wdg.set_tasks_sobjects(tasks_sobjects)

    def closeEvent(self, event):
        self.close_app()
        event.accept()

    def showEvent(self, *args, **kwargs):

        self.splitter.setSizes([200, 350])
