insert = SearchType.create('config/custom_script')
insert.set_value('code', """CUSTOM_SCRIPT00098""")
insert.set_value('folder', """cleanup_tools""")
insert.set_value('language', """python""")
insert.set_value('script', """import json

from pyasm.search import Search


PROJECT_CODE = 'niki_friends'
RELATIONS = (
    ('cg/texture_in_assets', 'assets_code', 'texture_code'),
    ('cg/assets_in_scenes', 'scenes_code', 'assets_code'),
    (
        'cg/assets_in_assets',
        'parent_assets_code',
        'child_assets_code',
    ),
)


server.set_project(PROJECT_CODE)
result = {}

for search_type, parent_column, child_column in RELATIONS:
    search = Search(search_type)
    search.add_order_by('timestamp')
    search.add_order_by('id')

    kept_by_pair = {}
    duplicates = []
    invalid = []

    for relation in search.get_sobjects():
        parent_code = relation.get_value(parent_column)
        child_code = relation.get_value(child_column)
        relation_code = relation.get_value('code')
        pair = parent_code, child_code

        if not all(pair):
            invalid.append(relation_code)
        elif pair not in kept_by_pair:
            kept_by_pair[pair] = relation_code
            continue
        else:
            duplicates.append({
                'code': relation_code,
                'kept': kept_by_pair[pair],
                parent_column: parent_code,
                child_column: child_code,
            })
        relation.delete(log=False, triggers=False)

    result[search_type] = {
        'duplicates': duplicates,
        'invalid': invalid,
        'deletedCount': len(duplicates) + len(invalid),
    }

return json.dumps(result, separators=(',', ':'))
""")
