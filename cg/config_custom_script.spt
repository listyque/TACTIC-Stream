insert.set_value('language', """python""")
insert.set_value('script', """from pyasm.prod.biz import ProdSetting

import json


server.set_project('dolly3d')
telegram_notifications_enabled = ProdSetting.get_value_by_key('telegram_notifications_enabled')
telegram_notifications_enabled = json.loads(telegram_notifications_enabled)


import telegram

bot = telegram.Bot(token='690330253:AAFdFCBJSj_bz7digLAHa4DUIFNe4PlQ6vA')

'''
from pprint import pformat

#assigned_user_chat_id_list = [479912061, 263854355]
CHECK_ID = 479912061

mess = pformat(input)
bot.send_message(chat_id=CHECK_ID, text=mess, parse_mode=telegram.ParseMode.HTML)

do_not_send_anything = True
'''


CHECK_ID = 479912061

if telegram_notifications_enabled:
    
    def get_related_task(sobj):
        search_code = sobj.get('search_code')
        process = sobj.get('process')
        
        if search_code and process:
            related_task = server.eval("@SOBJECT(sthpw/task['search_code', '{0}']['process', '{1}'])".format(search_code, process), single=True)
            if related_task:
                return related_task
        
    def get_user_from_task_sobj(sobj):
        assigned_user = sobj.get('assigned')
        
        if assigned_user:
            assigned_user_sobj = server.eval("@SOBJECT(sthpw/login['login','{0}'])".format(assigned_user), single=True)

            return assigned_user_sobj

    def get_user_from_note_sobj(sobj):
        assigned_user = sobj.get('login')
        
        if assigned_user:
            assigned_user_sobj = server.eval("@SOBJECT(sthpw/login['login','{0}'])".format(assigned_user), single=True)

            return assigned_user_sobj


    task_sobject = get_related_task(input['sobject'])
    
    note_sobject = input['sobject']
    sender_user = get_user_from_note_sobj(note_sobject)
    
    if task_sobject:
        assigned_user = get_user_from_task_sobj(task_sobject)
    else:
        assigned_user = None
    
    assigned_user_chat_id = None
    if assigned_user:
        assigned_user_chat_id = assigned_user['phone_number']
    
    sender_user_chat_id = None
    if sender_user:
        sender_user_chat_id = sender_user['phone_number']

    def generate_task_info_message(input, task_sobject, assigned_user, sender_user):
        message_text = None
    
        if input['mode'] == 'insert':
            note = input['update_data'].get('note')

            filters = [('code', task_sobject['search_code'])]
            related_sobject = server.query(task_sobject['search_type'], filters, single=True)
    
            #sender_telegram_login = bot.get_chat(assigned_user_chat_id)['username']
            #if sender_telegram_login:
            #    sender_user_title = u'{0} {1} @{2}'.format(sender_user['first_name'], sender_user['last_name'], sender_telegram_login)
            #else:
            #sender_user_title = u'{0} {1}'.format(sender_user['first_name'], sender_user['last_name'])
    
            related_sobject_name = related_sobject['name'].replace(' ', '_')
            task_process = task_sobject['context']
            #task_description = task_sobject['description']
            #parent_description = related_sobject['description']
            
            message_con = []
            message_con.append(u'✉️ <i>Сообщение к задаче: </i>  <b>#{0}</b>, '.format(related_sobject_name))
            if task_process:
                message_con.append(u'<i>Процесс:</i>  <b>#{0}</b>'.format(task_process))
            if note:
                message_con.append(u'<a href="tg://user?id={1}">{0}</a>:  {2}'.format(sender_user['display_name'], sender_user_chat_id, note))
            
            message_text = u''.join(message_con)
    
        return message_text
    
    
    if assigned_user:
        message_text = generate_task_info_message(input, task_sobject, assigned_user, sender_user)
    else:
        message_text = None
    
    
    if message_text:
    
        # sendging message to assigned user
        if assigned_user_chat_id:
            try:
                bot.send_message(chat_id=assigned_user_chat_id, parse_mode=telegram.ParseMode.HTML, text=message_text)
            except:
                mess = 'Message not sent to {0}'.format(assigned_user_chat_id)
                bot.send_message(chat_id=CHECK_ID, text=mess)""")
