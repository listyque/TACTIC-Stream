        self.fill_episodes_tree_widget()

    def create_progress_bar_widget(self):

        self.progress_bar_widget = QtGui.QProgressBar()
        self.progress_bar_widget.setTextVisible(True)
        self.progress_bar_widget.setHidden(True)
        self.statusbar.addPermanentWidget(self.progress_bar_widget)

    def set_progress_indicator_on(self):
        self.progress_bar_widget.setHidden(False)

    def set_progress_indicator_off(self):
        self.progress_bar_widget.setHidden(True)
        self.statusbar.showMessage('')

    def set_progress(self, progress, total_count=100, status_text=''):
        self.progress_bar_widget.setMaximum(total_count)
        self.statusbar.showMessage(status_text)
        self.progress_bar_widget.setValue(progress + 1)
        if self.progress_bar_widget.maximum() == progress + 1:
            self.set_progress_indicator_off()

    def add_missing_episode_to_tree_widget(self, sobject, tasks_sobjects):

        search_key = sobject.get_search_key()

        item_info = {
            'relates_to': 'checkin_out',
            'sep_versions': True,
            'children_states': None,
            'simple_view': True,
            'forced_creation': True,
        }
        episode_layout_widget = gf.add_sobject_item(
            self.episodes_tree_widget,
            self,
            sobject,
            self.stype,
            item_info,
            ignore_dict=None,
            return_layout_widget=True
        )
        self.episodes_overlay_widgets[search_key] = Ui_episodeOverlayWidget(self, episode_layout_widget.get_widget(), sobject, self)
        self.episodes_layout_widgets[search_key] = episode_layout_widget

        episode_overlay_widget = self.episodes_overlay_widgets.get(search_key)
        episode_overlay_widget.set_tasks_sobjects(tasks_sobjects)

    def cleanup_episodes_tree_widget(self, sobjects):

        # Taking off all items that not found by last query
        if len(sobjects) > 0:
            for search_key, episode_overlay_widget in self.episodes_overlay_widgets.items():

                if search_key not in sobjects.keys():
                    for idx in range(self.episodes_tree_widget.topLevelItemCount()):

                        item = self.episodes_tree_widget.topLevelItem(idx)
                        episode_layout_widget = self.episodes_tree_widget.itemWidget(item, 0)

                        if episode_layout_widget:
                            episode_widget = episode_layout_widget.get_widget()

                            if episode_widget.get_search_key() == search_key:
                                self.episodes_tree_widget.takeTopLevelItem(idx)
                                del self.episodes_overlay_widgets[search_key]
        else:
            self.episodes_overlay_widgets = collections.OrderedDict()
            self.schedule_tree_widget.clear()

    def fill_episodes_tree_widget(self):

        search_type = self.stype.info['code']
        project_code = self.stype.project.get_code()
        full_search_type = tc.server_start().build_search_type(search_type, project_code=project_code)
        sobjects, info = tc.get_sobjects(full_search_type, filters=EXPR_FILTER, order_bys=['name'])

        self.episodes_tree_widget.clear()

        for search_key, sobject in sobjects.items():

            item_info = {
                'relates_to': 'checkin_out',
                'sep_versions': True,
                'children_states': None,
                'simple_view': True,
                'forced_creation': True,
            }
            episode_layout_widget = gf.add_sobject_item(
                self.episodes_tree_widget,
                self,
                sobject,
                self.stype,
                item_info,
                ignore_dict=None,
                return_layout_widget=True
            )

            self.episodes_overlay_widgets[search_key] = Ui_episodeOverlayWidget(self, episode_layout_widget.get_widget(), sobject, self)
            self.episodes_layout_widgets[search_key] = episode_layout_widget
            episode_layout_widget.get_widget().show()
            episode_layout_widget.get_widget().item_info_widget.setHidden(True)

    def create_schedule_widget(self):

        self.schedule_tree_widget = QtGui.QTreeWidget()
        self.schedule_tree_widget.setTabKeyNavigation(True)
        self.schedule_tree_widget.setVerticalScrollMode(QtGui.QAbstractItemView.ScrollPerPixel)
        self.schedule_tree_widget.setRootIsDecorated(False)
        self.schedule_tree_widget.setAllColumnsShowFocus(True)
        self.schedule_tree_widget.setWordWrap(True)
        self.schedule_tree_widget.setHeaderHidden(True)
        self.schedule_tree_widget.setSelectionMode(QtGui.QAbstractItemView.SingleSelection)
        self.schedule_tree_widget.setObjectName("schedule_tree_widget")
        self.schedule_tree_widget.setContextMenuPolicy(QtCore.Qt.CustomContextMenu)
        self.schedule_tree_widget.setStyleSheet(gf.get_qtreeview_style())

        self.schedule_vertical_layout.addWidget(self.schedule_tree_widget)

    def episodes_tree_widget_selection_changes(self):
        items = self.episodes_tree_widget.selectedItems()

        if items:
            widget_item = self.episodes_tree_widget.itemWidget(items[0], 0).get_widget()
            episode_overlay_widget = self.episodes_overlay_widgets.get(widget_item.sobject.get_search_key())
            if episode_overlay_widget:
                if len(episode_overlay_widget.get_shots_overlay_widgets()) > 0:
                    self.fill_schedule_tree_widget(episode_overlay_widget)
                else:
                    self.update_and_fill_schedule_tree_widget(episode_overlay_widget)

    def shots_tree_widget_updating(self, episode_overlay_widget):

        self.set_progress(1, 100, 'Updating shots')
        if episode_overlay_widget:
            if len(episode_overlay_widget.get_shots_overlay_widgets()) > 0:
                self.fill_schedule_tree_widget(episode_overlay_widget)
            else:
                self.update_and_fill_schedule_tree_widget(episode_overlay_widget)

    def fill_schedule_tree_widget(self, episode_overlay_widget=None):
        if episode_overlay_widget:
            # episode_sobject = episode_overlay_widget.episode_sobject

            self.temp_parent_widget = QtGui.QDialog(self)
            self.temp_parent_widget.setHidden(True)

            # Here we taking all the shots widgets with their overlay, and leave layout widgets to be cleared safely
            for idx in range(self.schedule_tree_widget.topLevelItemCount()):
                item = self.schedule_tree_widget.topLevelItem(idx)
                shot_layout_widget = self.schedule_tree_widget.itemWidget(item, 0)

                last_shot_widget = shot_layout_widget.take_widget(self.temp_parent_widget)
                last_shot_overlay_widget = last_shot_widget.get_overlay_widget()
                last_episode_search_key = last_shot_overlay_widget.episode_sobject.get_search_key()

                shot_search_key = last_shot_widget.sobject.get_search_key()
                last_episode_overlay_widget = self.episodes_overlay_widgets.get(last_episode_search_key)
                if last_episode_overlay_widget:
                    last_episode_overlay_widget.shots_widgets[shot_search_key] = last_shot_widget

            # now clearing all tree items with abandoned layout widgets
            self.schedule_tree_widget.clear()

            # now we creating new layout to ur existing widgets
            for search_key, shot_widget in episode_overlay_widget.shots_widgets.items():

                tree_item = QtGui.QTreeWidgetItem()
                tree_item.setChildIndicatorPolicy(QtGui.QTreeWidgetItem.ShowIndicator)

                shot_widget.tree_item = tree_item
                shot_layout_widget = Ui_layoutWrapWidget()
                shot_layout_widget.set_widget(shot_widget)
                gf.add_item_to_tree(self.schedule_tree_widget, tree_item, shot_layout_widget)

                # shot_overlay_widget = episode_overlay_widget.shots_overlay_widgets[search_key]
                episode_overlay_widget.shots_layout_widgets[search_key] = shot_layout_widget

    def update_and_fill_schedule_tree_widget(self, episode_overlay_widget=None):
        if episode_overlay_widget:

            episode_widget = episode_overlay_widget.episode_widget
            episode_sobject = episode_widget.get_sobject()
            # parent_skey = episode_sobject.get_search_key()
            children_stype = env_inst.get_current_stype_by_code('cg/shot')

            sobjects, info = episode_sobject.get_related_sobjects(children_stype, episode_sobject.get_stype())

            self.temp_parent_widget = QtGui.QDialog(self)
            self.temp_parent_widget.setHidden(True)

            # Here we taking all the shots widgets with their overlay, and leave layout widgets to be cleared safely
            for idx in range(self.schedule_tree_widget.topLevelItemCount()):
                item = self.schedule_tree_widget.topLevelItem(idx)
                shot_layout_widget = self.schedule_tree_widget.itemWidget(item, 0)

                last_shot_widget = shot_layout_widget.take_widget(self.temp_parent_widget)
                last_shot_overlay_widget = last_shot_widget.get_overlay_widget()
                last_episode_search_key = last_shot_overlay_widget.episode_sobject.get_search_key()

                shot_search_key = last_shot_widget.sobject.get_search_key()
                last_episode_overlay_widget = self.episodes_overlay_widgets.get(last_episode_search_key)
                if last_episode_overlay_widget:
                    last_episode_overlay_widget.shots_widgets[shot_search_key] = last_shot_widget

            # now clearing all tree items with abandoned layout widgets
            self.schedule_tree_widget.clear()

            episode_overlay_widget = self.episodes_overlay_widgets.get(episode_sobject.get_search_key())

            for search_key, sobject in sobjects.items():

                item_info = {
                    'relates_to': 'checkin_out',
                    'sep_versions': True,
                    'children_states': None,
                    'simple_view': True,
                    'forced_creation': True,
                }
                shot_layout_widget = gf.add_sobject_item(
                    self.schedule_tree_widget,
                    self,
                    sobject,
                    sobject.get_stype(),
                    item_info,
                    ignore_dict=None,
                    return_layout_widget=True,
                )

                if episode_overlay_widget:
                    shot_widget = shot_layout_widget.get_widget()

                    shot_overlay_widget = Ui_shotOverlayWidget(episode_widget, episode_sobject, shot_widget, sobject, self)

                    episode_overlay_widget.shots_overlay_widgets[search_key] = shot_overlay_widget
                    episode_overlay_widget.shots_layout_widgets[search_key] = shot_layout_widget

                    shot_widget.add_overlay_widget(shot_overlay_widget)
                    shot_widget.show_overlay()

    def close_app(self):
        env_inst.ui_main.show()
        env_inst.ui_script_editor.show()
        self.close()
        self.deleteLater()

    def controls_actions(self):
        self.start_scheduler_button.clicked.connect(self.toggle_start_stop)
        self.refresh_scheduler_button.clicked.connect(lambda: self.perform_update(initial=True))
        self.config_button.clicked.connect(self.open_config_dialog)
        self.hide_window_button.clicked.connect(self.hide)

        self.episodes_tree_widget.itemSelectionChanged.connect(self.episodes_tree_widget_selection_changes)

        self.episodes_tree_widget.customContextMenuRequested.connect(self.open_episodes_context_menu)
        self.schedule_tree_widget.customContextMenuRequested.connect(self.open_schedule_context_menu)

        self._updateTimer.timeout.connect(self.perform_update)

