insert = SearchType.create('config/custom_script')
insert.set_value('code', """CUSTOM_SCRIPT00092""")
insert.set_value('folder', """dev""")
insert.set_value('language', """local_python""")
insert.set_value('script', """# Получение всех групп конкретного логина

from pyasm.search import Search, SearchType

server.set_project('niki_friends')

# К примеру нам нужно отобразить все группы выбранного пользователя и у нас есть его логин или код
# делаем просто запрос с базы с его собжектом

USER_LOGIN = 'listy'

search = Search('sthpw/login')
search.add_filter('login', USER_LOGIN)

login_sobjects = search.get_sobjects()

# На случай если мы не знаем логин, но знаем код
USER_LOGIN = login_sobjects[0].get_value('login')

# после того как мы получили логин делаем запрос на все группы к которым относится этот пользователь
all_login_groups = Search.eval('@SOBJECT(sthpw/login_group.sthpw/login_in_group["login", "{0}"])'.format(USER_LOGIN))


# Теперь коннектим юзера к нужным группам

instance_type = 'sthpw/login_in_group'


for group in all_login_groups:
    instance = SearchType.create(instance_type)
    
    # логин соединяем с группой через логин в группе
    src_sobject = login_sobjects[0]
    dst_sobject = group

    # Возможно их придется поменять местами, нужно проверять, проверь
    instance.add_related_connection(src_sobject, dst_sobject)

    instance.commit()
    
# Скажем нам нужно отключить от юзера конкретные группы (убрали галки с группы)

for group in all_login_groups:
    group.remove_instance(login_sobjects[0])""")
