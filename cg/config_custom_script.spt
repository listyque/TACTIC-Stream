insert = SearchType.create('config/custom_script')
insert.set_value('code', """CUSTOM_SCRIPT00041""")
insert.set_value('folder', """batch""")
insert.set_value('language', """local_python""")
insert.set_value('script', """# -*- coding: utf-8 -*-

# TODO Connection twice when restarting or starting +
# TODO fetch shot data +
# TODO test render +
# TODO extract caches +
# TODO save render logs to render process +
# TODO read and mark rendered as exclude +
# TODO add global progress bar +

# TODO Refresh schedule tree after render done
# TODO interrupt render -
# TODO menu actions on shots -
# TODO Colorize statuses of shots -
# TODO do not let run two episodes at a time, instead set On schedule status -

import os
import codecs
import collections
from thlib.side.Qt import QtWidgets as QtGui
from thlib.side.Qt import QtGui as Qt4Gui
from thlib.side.Qt import QtCore
from thlib.environment import env_inst, env_mode, env_write_config, env_read_config
import thlib.global_functions as gf
import thlib.tactic_classes as tc
from thlib.ui_classes.ui_repo_sync_queue_classes import Ui_repoSyncDialog
from thlib.ui_classes.ui_custom_qwidgets import MenuWithLayout, Ui_collapsableWidget
from thlib.ui_classes.ui_item_classes import Ui_layoutWrapWidget

CURRENT_PROJECT = 'niki_friends'
ALL_RENDER_STATUSES = [u'Подготовлен', u'Рендер', u'В очереди', u'Рендерится', u'Ошибки', u'Готов', u'Проверен']
RENDER_START_STATUS = u'Рендер'
RENDER_PROCESS = u'render'
CACHE_PATH = u'{0}/cache/nCache'.format(CURRENT_PROJECT)
ALEMBIC_CACHE_PATH = u'cache/alembic'
EXPR_FILTER = [('_expression', 'in', u"@SOBJECT(sthpw/task['process', '{}']['status', 'not in', 'Проверен'])".format(RENDER_PROCESS))]

DEF_MAYA_PATH = u'C:/Program Files/Autodesk/Maya2022/bin/Render.exe'
DEF_SAVE_PATH = u'D:/sequences_path'
DEF_PROJECT_PATH = u'D:/sequences_path'
DEF_CAMERA = 'ubercam'


def get_configs():
    global MAYA_PATH
    global SAVE_PATH
    global CAMERA

    conf_dict = env_read_config(unique_id='batch_dispatcher')
    MAYA_PATH = gf.get_value_from_config(conf_dict, 'maya_path_line_edit', DEF_MAYA_PATH)
    SAVE_PATH = gf.get_value_from_config(conf_dict, 'save_path_line_edit', DEF_SAVE_PATH)
    CAMERA = gf.get_value_from_config(conf_dict, 'camera_line_edit', DEF_CAMERA)


get_configs()


class mayaBatchClass(QtCore.QObject):

    render_starting = QtCore.Signal()
    render_running = QtCore.Signal()
    render_stopped = QtCore.Signal()
    render_interrupted = QtCore.Signal()
    render_finished = QtCore.Signal()
    progress_out = QtCore.Signal(object)

    def __init__(self, parent=None):
        super(self.__class__, self).__init__(parent=parent)

        self.batch_process = QtCore.QProcess(self)
        self.test_render = False
        self.maya_path = MAYA_PATH
        self.sequences_save_path = SAVE_PATH
        self.camera_name = CAMERA
        self.maya_scene_path = ''
        self.start_frame = 1
        self.end_frame = 1
        self.maya_batch_args = []
        self.sobject = None
        self.parent_sobject = None

        self.actions()

    def customize_by_sobject(self, sobject, test_render=False):

        self.sobject = sobject
        self.test_render = test_render

        if not test_render:
            self.start_frame = sobject.get_value('start_frame')
            self.end_frame = sobject.get_value('end_frame')

        sobject.get_snapshots()
        publish_process = sobject.process.get('publish')
        if publish_process:
            first_context = list(publish_process.get_contexts().values())[0]
            versionless_snapshot = list(first_context.get_versionless().values())[0]

            # getting all full abs path of maya scene
            for snapshot_file in versionless_snapshot.get_files_objects():
                if snapshot_file.get_type() == 'main':
                    self.maya_scene_path = snapshot_file.get_full_abs_path()

    def start_batch(self):
        self.maya_batch_args.append('-renderer file')
        # self.maya_batch_args.append('-log "{0}.log"'.format(self.maya_scene_path))
        # self.maya_batch_args.append('-r redshift -gpu {1}')
        self.maya_batch_args.append('-s {}'.format(self.start_frame))
        self.maya_batch_args.append('-e {}'.format(self.end_frame))
        # self.maya_batch_args.append('-cam {}'.format(self.camera_name))
        # self.maya_batch_args.append('-skipExistingFrames')
        self.maya_batch_args.append(u'-rd "{0}" "{1}"'.format(self.sequences_save_path, self.maya_scene_path))
        self.batch_process.setProcessChannelMode(QtCore.QProcess.MergedChannels)

        self.batch_process.readyRead.connect(self.progress_output)

        self.batch_process.waitForReadyRead(True)

        self.batch_process.start(u'"{0}" {1}'.format(self.maya_path, u' '.join(self.maya_batch_args)), [])

    def progress_output(self):
        if env_mode.py3:
            log_output = str(self.batch_process.readAllStandardOutput(), encoding='utf-8')
        else:
            log_output = str(self.batch_process.readAllStandardOutput())

        self.progress_out.emit(log_output)

        self.write_log(log_output)

    def write_log(self, log_text):
        log_path = u'{0}.log'.format(self.maya_scene_path)

        if os.path.exists(gf.extract_dirname(log_path)):
            with codecs.open(log_path, 'a+', 'utf-8') as log_file:
                log_file.write(log_text)
        else:
            os.makedirs(gf.extract_dirname(log_path))
            with codecs.open(log_path, 'w+', 'utf-8') as log_file:
                log_file.write(log_text)

        log_file.close()

    def actions(self):
        self.batch_process.error.connect(self.error_handle)
        self.batch_process.finished.connect(self.finished_handle)
        self.batch_process.stateChanged.connect(self.state_changed_handle)
        self.batch_process.readyRead.connect(self.progress_output)

    def error_handle(self, message=None):
        if message:
            print('Some errors', message)

    def finished_handle(self, exit_code=None):
        if not self.test_render:
            self.upload_log()

        if exit_code == 0:
            if not self.test_render:
                try:
                    self.set_rendered()
                except:
                    print('FAILED SET RENDERED')
            self.render_finished.emit()
        elif exit_code == 1:
            self.batch_process.readAllStandardError()
            self.render_interrupted.emit()
        else:
            if not self.test_render:
                self.set_failed()
            self.batch_process.readAllStandardError()
            self.render_interrupted.emit()

    def state_changed_handle(self, state=None):

        if state == QtCore.QProcess.ProcessState.Starting:
            self.render_starting.emit()
        if state == QtCore.QProcess.ProcessState.Running:
            self.render_running.emit()
        if state == QtCore.QProcess.ProcessState.NotRunning:
            self.render_stopped.emit()

    def upload_log(self):

        shot_context = u'render/{}'.format(self.sobject.get_title())
        shot_logfile = u'{0}.log'.format(self.maya_scene_path)
        description = u'Log file for Shot {}'.format(self.sobject.get_title())
        try:
            if os.path.exists(shot_logfile):
                tc.server_start().simple_checkin(
                    self.parent_sobject.get_search_key(),
                    shot_context,
                    shot_logfile,
                    description=description
                )

                os.remove(shot_logfile)
        except:
            print('Failed to Upload Log to server', description)

    def set_rendered(self):
        data = {
            'rendered': True
        }
        return tc.server_start().update(self.sobject.get_search_key(), data)

    def set_failed(self):
        data = {
            'rendered': False
        }
        return tc.server_start().update(self.sobject.get_search_key(), data)

    def is_rendered(self):

        return self.sobject.get_value('rendered')


class Ui_episodeOverlayWidget(QtGui.QWidget):
    batch_completed = QtCore.Signal(object, object, object)
    preprocessed = QtCore.Signal(object)
    batch_completed_connected = False

    def __init__(self, batch_ui_widget, episode_widget, episode_sobject, parent=None):
        super(self.__class__, self).__init__(parent=parent)

        self.episode_widget = episode_widget
        self.episode_sobject = episode_sobject

        self.shots_widgets = collections.OrderedDict()
        self.shots_layout_widgets = collections.OrderedDict()
        self.shots_overlay_widgets = collections.OrderedDict()
        self.tasks_sobjects = collections.OrderedDict()

        self.batch_result = None

        self.batch_ui_widget = batch_ui_widget

        self.setParent(self.episode_widget)

        self.create_ui()

    def create_ui(self):

        self.layout_widget = QtGui.QWidget(self.episode_widget)
        sizePolicy = QtGui.QSizePolicy(QtGui.QSizePolicy.Preferred, QtGui.QSizePolicy.Preferred)
        self.layout_widget.setSizePolicy(sizePolicy)

        self.main_layout = QtGui.QGridLayout(self.layout_widget)
        self.main_layout.setSpacing(0)
        self.main_layout.setContentsMargins(160, 0, 8, 0)

        self.layout_widget.setLayout(self.main_layout)
        self.label = QtGui.QLabel()

        spacerItem = QtGui.QSpacerItem(40, 20, QtGui.QSizePolicy.Expanding, QtGui.QSizePolicy.Minimum)
        self.main_layout.addItem(spacerItem, 0, 0)

        self.main_layout.addWidget(self.label, 0, 1)

        self.layout_widget.show()
        # self.layout_widget.resize(self.episode_widget.size())

        self.episode_widget.resizeEvent = self.resizeEvent

    def set_tasks_sobjects(self, tasks_sobjects_dict):
        self.tasks_sobjects = tasks_sobjects_dict
        self.customize_by_task()

    def get_shots_overlay_widgets(self):
        return self.shots_overlay_widgets

    def get_shots_layout_widgets(self):
        return self.shots_layout_widgets

    def customize_by_task(self):
        stype = self.episode_sobject.get_stype()

        workflow = stype.get_workflow()
        tasks_pipelines = workflow.get_by_stype_code('sthpw/task')

        episode_status = ''
        status_color = '#ffffff'

        for search_key, task_sobject in self.tasks_sobjects.items():
            task_pipeline_code = task_sobject.info.get('pipeline_code')
            episode_status = task_sobject.get_value('status')
            if task_pipeline_code:
                task_pipeline = tasks_pipelines.get(task_pipeline_code)
                episode_status_info = task_pipeline.get_pipeline_process(episode_status)
                if episode_status_info:
                    status_color = episode_status_info['color']

        self.label.setText(u'<span style=" font-size:10pt; font-weight:300; color:{1};">{0}</span>'.format(
            episode_status,
            status_color
        ))

        if episode_status in [u'Рендер', u'В очереди']:
            self.batch_ui_widget.add_episode_to_render_queue(self.episode_sobject.get_search_key())
        else:
            self.batch_ui_widget.remove_episode_from_render_queue(self.episode_sobject.get_search_key())

    def get_latest_assets(self):
        self.batch_ui_widget.log_text_edit.appendPlainText('-'*25 + ' Getting Assets ' + '-'*25)

        self.batch_ui_widget.set_status('Getting Assets')
        self.batch_ui_widget.set_progress(20, 100, 'Preprocessing All Files for shots')

        sobject = self.episode_sobject
        stype = self.episode_widget.stype
        sync_dialog = Ui_repoSyncDialog(parent=self.batch_ui_widget, stype=stype, sobject=sobject)
        sync_dialog.apply_repo_sync_preset(preset_name='render_sync')
        sync_dialog.setWindowModality(QtCore.Qt.ApplicationModal)
        sync_dialog.show()
        
        preset_dict = sync_dialog.get_preset_config('render_sync', json=False)
        if preset_dict:
            sync_dialog.file_download_done.connect(self.download_log)
            sync_dialog.downloads_finished.connect(self.prepare_caches)
            sync_dialog.downloads_finished.connect(sync_dialog.hide)

            # sync_dialog.start_sync(preset_dict['data'])
            sync_dialog.start_sync_ui(preset_dict['data'])

    def download_log(self, fl):
        self.batch_ui_widget.log_text_edit.appendPlainText(u'Downloaded: {0}'.format(fl.get_full_abs_path()))

    def prepare_caches(self):
        self.batch_ui_widget.log_text_edit.appendPlainText('-' * 50 + ' All Assets Got ' + '-' * 50)
        self.batch_ui_widget.log_text_edit.appendPlainText('-' * 50 + ' Preparing caches ' + '-' * 50)
        self.batch_ui_widget.set_status('Extracting Caches')

        self.batch_ui_widget.set_progress(30, 100, 'Preparing Caches')

        def extract_cache(cache_snapshot, shot_sobject):
            episode_title = self.episode_sobject.get_title()
            shot_title = shot_sobject.get_title()
            destination_path = u'{0}/{1}/{2}/{3}'.format(
                cache_snapshot.get_repo_path(),
                CACHE_PATH,
                episode_title,
                shot_title
            )
            gf.extract_zip_archive(cache_snapshot.get_full_abs_path(), gf.form_path(destination_path))

        parent_sobject = None

        for shot in self.shots_overlay_widgets.values():
            shot_sobject = shot.shot_sobject
            if not parent_sobject:
                parent_search_type = 'cg/scenes?project={0}'.format(CURRENT_PROJECT)
                ep_code = shot_sobject.get_value('scenes_code')
                parent_sobject, info = tc.get_sobjects_new(search_type=parent_search_type, filters=[(u'code', ep_code)])
                if parent_sobject:
                    parent_sobject = list(parent_sobject.values())[0]

            shot_sobject.get_snapshots()
            cache_process = shot_sobject.process.get('cache')
            if cache_process:
                first_context = list(cache_process.get_contexts().values())[0]
                versionless_snapshot = list(first_context.get_versionless().values())[0]

                # getting cache snapshots
                for snapshot_file in versionless_snapshot.get_files_objects():
                    if snapshot_file.get_type() == 'main':
                        extract_cache(snapshot_file, shot_sobject)

        # Alembic caches preparing routine

        self.batch_ui_widget.set_progress(35, 100, 'Preparing Alembic Caches')

        def extract_abc_cache(cache_snapshot):
            abc_cache_dir = u'{0}{1}'.format(cache_snapshot.get_repo_path(), ALEMBIC_CACHE_PATH)
            new_cache_path = u'{0}/'.format(abc_cache_dir)

            gf.extract_zip_archive(cache_snapshot.get_full_abs_path(), gf.form_path(new_cache_path))

        if parent_sobject:

            children_stype = env_inst.get_current_stype_by_code('cg/assets')
            filters = [('assets_category_code', 'cache/abc')]
            all_caches_assets_sobjects = collections.OrderedDict()

            # getting all cache assets for each asset added to the episode
            all_assets_sobjects, _ = parent_sobject.get_related_sobjects(children_stype)
            for asset_sobject in all_assets_sobjects.values():
                asset_caches_sobjects, _ = asset_sobject.get_related_sobjects(children_stype, filters=filters)

                if asset_caches_sobjects:
                    all_caches_assets_sobjects.update(asset_caches_sobjects)

            # getting only cache assets directly connected to episode
            assets_sobjects, _ = parent_sobject.get_related_sobjects(children_stype, filters=filters)
            all_caches_assets_sobjects.update(assets_sobjects)

            for asset_sobject in all_caches_assets_sobjects.values():
                # print(asset_sobject.info['name'])

                snapshots_list = asset_sobject.query_snapshots(asset_sobject.info['code'])
                asset_sobject.init_snapshots(snapshots_list)
                cache_process = asset_sobject.process.get('publish')

                if cache_process:
                    first_context = list(cache_process.get_contexts().values())[0]
                    versionless_snapshot = list(first_context.get_versionless().values())[0]

                    # getting cache snapshots
                    for snapshot_file in versionless_snapshot.get_files_objects():
                        if snapshot_file.get_type() == 'main':
                            # print(snapshot_file)
                            if snapshot_file.get_ext() == 'zip':
                                print('All set, getting things ready')
                                self.batch_ui_widget.log_text_edit.appendPlainText(asset_sobject.info['name'])
                                extract_abc_cache(snapshot_file)
                            else:
                                print('This is not a ZIP File! Skipping')

        self.preprocessed.emit(True)

    def connect_batch_completed(self, func):
        self.batch_completed.connect(func)
        self.batch_completed_connected = True

    def is_batch_completed_connected(self):
        return self.batch_completed_connected

    def begin_batch(self, test_render=False):
        # self.batch_ui_widget.update_and_fill_schedule_tree_widget(self.episode_widget)
        # self.batch_ui_widget.shots_tree_widget_updating(self.episode_widget)

        for shot_overlay_widget in self.shots_overlay_widgets.values():
            if shot_overlay_widget.is_completed():
                shot_overlay_widget.is_complete = False
                shot_overlay_widget.create_batch_object()
            else:
                shot_overlay_widget.shot_render_finished.connect(lambda: self.batch_queue(test_render))
                shot_overlay_widget.shot_progress_log.connect(self.batch_progress_log)

        self.batch_queue(test_render)

    def complete_batch(self, test_render=False):
        self.batch_result = 'complete'

        for shot in self.shots_overlay_widgets.values():
            if shot.get_result_status() in ['errors', 'interrupted']:
                self.batch_result = shot.get_result_status()
                break

        self.batch_ui_widget.set_progress(99, 100, 'Batch Processing Complete')

        self.batch_completed.emit(self.batch_result, self.episode_widget, test_render)

    def batch_progress_log(self, log):
        self.batch_ui_widget.log_text_edit.appendPlainText(str(log))

    def batch_queue(self, test_render=False):
        # shots_overlay_widgets = self.get_shots_widgets()
        # shots_list = list(reversed(shots_overlay_widgets.values()))
        # shots_list = list(shots_overlay_widgets.values())

        next_in_queue = 0
        for shots_overlay_widget in self.shots_overlay_widgets.values():
            if shots_overlay_widget.is_completed():
                next_in_queue += 1

        if next_in_queue < len(list(self.shots_overlay_widgets.values())):
            shots_overlay_widget = list(self.shots_overlay_widgets.values())[next_in_queue]
            current_progress = int(float(next_in_queue) * 100.0 / float(len(list(self.shots_overlay_widgets.values()))))

            shot_sobject = shots_overlay_widget.shot_sobject
            self.batch_ui_widget.set_progress(current_progress, 100, u'Rendering {0}'.format(shot_sobject.get_title()))
            shots_overlay_widget.start_batch_render(test_render)
        else:
            self.complete_batch(test_render)

    def resizeEvent(self, event):
        self.layout_widget.resize(self.episode_widget.size())


class Ui_shotOverlayWidget(QtGui.QWidget):
    shot_render_finished = QtCore.Signal()
    shot_progress_log = QtCore.Signal(object)

    def __init__(self, episode_widget, episode_sobject, shot_widget, shot_sobject, parent=None):
        super(self.__class__, self).__init__(parent=parent)

        self.episode_widget = episode_widget
        self.episode_sobject = episode_sobject

        self.shot_widget = shot_widget
        self.shot_sobject = shot_sobject

        self.is_complete = False
        self.result_status = None

        self.batch_object = None

        self.create_batch_object()

        self.create_ui()

        self.actions()

    def create_ui(self):

        self.main_layout = QtGui.QGridLayout(self)
        self.main_layout.setSpacing(9)
        self.main_layout.setContentsMargins(160, 0, 8, 0)
        self.setLayout(self.main_layout)

        self.label = QtGui.QLabel(self)
        self.set_status('Waiting')

        self.active_check_box = QtGui.QCheckBox(self)
        if self.shot_sobject.get_value('rendered'):
            self.active_check_box.setChecked(True)
        else:
            self.active_check_box.setChecked(False)
        self.active_check_box.setText('Exclude')

        spacerItem = QtGui.QSpacerItem(40, 20, QtGui.QSizePolicy.Expanding, QtGui.QSizePolicy.Minimum)

        self.main_layout.addItem(spacerItem, 0, 0)
        self.main_layout.addWidget(self.label, 0, 1)
        self.main_layout.addWidget(self.active_check_box, 0, 2)

    def create_batch_object(self):
        self.batch_object = mayaBatchClass(self)
        self.batch_object.parent_sobject = self.episode_sobject

        self.actions()

    def actions(self):
        self.batch_object.render_finished.connect(self.batch_render_finished)
        self.batch_object.render_interrupted.connect(self.batch_render_interrupted)
        self.batch_object.progress_out.connect(self.progress_log)

    def progress_log(self, progress_log=None):
        self.shot_progress_log.emit(progress_log)

    def set_shot_widget(self, shot_widget):
        self.shot_widget = shot_widget
        self.setParent(self.shot_widget)
        self.create_ui()

    def set_status(self, status_text):
        status_color = '#FFFFFF'

        status_rich_text = u'<span style=" font-size:10pt; font-weight:300; color:{1};">{0}</span>'.format(
            status_text,
            status_color
        )

        self.label.setText(status_rich_text)

    def is_excluded(self):
        return self.active_check_box.isChecked()

    def get_result_status(self):
        return self.result_status

    def start_batch_render(self, test_render=False):
        self.batch_object.customize_by_sobject(self.shot_sobject, test_render)
        framerange = '{} - {}'.format(self.batch_object.start_frame, self.batch_object.end_frame)
        self.set_status('Rendering {} frames'.format(framerange))

        if self.shot_sobject.get_value('rendered'):
            if self.is_excluded():
                self.batch_render_skipped()
            else:
                self.batch_object.start_batch()
        else:
            if self.is_excluded():
                self.batch_render_skipped()
            else:
                self.batch_object.start_batch()

    def batch_render_finished(self):
        self.set_status('Complete')
        self.is_complete = True
        self.result_status = 'complete'
        self.shot_render_finished.emit()

    def batch_render_skipped(self):
        self.set_status('Skipped')
        self.is_complete = True
        self.result_status = 'complete'
        self.shot_render_finished.emit()

    def batch_render_interrupted(self):
        self.set_status('Interrupted')
        self.is_complete = True
        self.result_status = 'interrupted'
        self.shot_render_finished.emit()

    def is_completed(self):
        return self.is_complete


class Ui_batchSchedulerWidget(QtGui.QMainWindow):
    def __init__(self, parent=None):
        super(self.__class__, self).__init__(parent=parent)

        self.scheduler_status = 'stopped'
        self.batch_render_status = 'waiting'
        self.render_queue = []

        self.update_interval = 10
        self._updateTimer = QtCore.QTimer(self)

        self.episodes_overlay_widgets = collections.OrderedDict()
        self.episodes_layout_widgets = collections.OrderedDict()

        self.stype = env_inst.get_current_stype_by_code('cg/scenes')

        self.create_ui()

        self.subscriptions = None
        self.messages = None

        self.perform_update(initial=True)
        self.start_update_timer()

    def create_ui(self):
        self.create_layout()

        self.resize(950, 600)
        self.setMinimumSize(750, 500)
        # self.setSizeGripEnabled(True)
        self.setWindowFlags(QtCore.Qt.Window | QtCore.Qt.WindowStaysOnTopHint)
        self.setWindowModality(QtCore.Qt.WindowModal)
        self.setFocusPolicy(QtCore.Qt.StrongFocus)

        self.create_all_layouts()

        self.create_episodes_widget()
        self.create_schedule_widget()

        self.create_progress_bar_widget()

        self.create_buttons()
        self.create_log_widget()

        self.create_tray_actions()
        self.create_tray_icon()
        self.set_app_icon()
        self.trayIcon.show()

        self.set_title()

        self.controls_actions()

        # self.toggle_start_stop()

    def create_layout(self):
        self.mainwidget = QtGui.QWidget(self)
        self.mainwidget.setObjectName("mainwidget")
        self.setCentralWidget(self.mainwidget)

        self.grid_layout = QtGui.QGridLayout(self.mainwidget)

        self.statusbar = QtGui.QStatusBar(self)
        self.statusbar.setObjectName("statusbar")
        self.setStatusBar(self.statusbar)

    def create_all_layouts(self):
        self.splitter = QtGui.QSplitter(self)
        self.splitter.setOrientation(QtCore.Qt.Horizontal)
        self.splitter.setObjectName("splitter")

        self.gridLayoutWidget = QtGui.QWidget(self.splitter)
        self.gridLayoutWidget.setObjectName("gridLayoutWidget")

        self.parent_grid_layout = QtGui.QGridLayout(self.gridLayoutWidget)
        self.parent_grid_layout.setContentsMargins(0, 0, 0, 0)
        self.parent_grid_layout.setObjectName("parent_grid_layout")

        self.parent_vertical_layout = QtGui.QVBoxLayout()

        self.parent_vertical_layout.setObjectName("parent_vertical_layout")

        self.parent_grid_layout.addLayout(self.parent_vertical_layout, 0, 0, 1, 1)

        self.verticalLayoutWidget = QtGui.QWidget(self.splitter)
        self.verticalLayoutWidget.setObjectName("verticalLayoutWidget")

