<behavior class="process_link"><![CDATA[
{
  "type": "click_up",
  "cbjs_action": '''

//console.dir(bvr.src_el);
//console.dir(bvr.kwargs);
//console.dir(bvr.src_el.attributes.href);
var process_code = bvr.src_el.attributes.href.value;

//alert(process_code);

var lay = bvr.src_el.getParent(".spt_tab_top");
var panel = spt.api.get_element(lay, '.episodes_table_content');
var table = spt.api.get_element(panel, '.spt_custom_top');

//var class_name = 'tactic.ui.panel.TableLayoutWdg';
var class_name = 'tactic.ui.panel.ViewPanelWdg';
var search_keys = bvr.kwargs[process_code];

// FAKING SEARCH KEY IF NULL
if (search_keys == ''){
    search_keys = ['cg/scenes?project=dolly3d&id=0']
}

var kwargs = {
'search_keys': search_keys,
'search_type': 'cg/scenes',
'simple_search_view': 'simple_filter',
'view': 'table',
}
spt.panel.load(table, class_name, kwargs);


'''
}
]]></behavior>


