insert.set_value('config', """<config>
<episodes.columns.script>
<mako>
<![CDATA[
script_link = sobject.get('script')

edit_links = '&lt;div style="font-size: 12pt; padding: 20px"&gt;There is no Script yet You can add some here: &lt;a href="#" class="add_pop"&gt; Edit Script Link&lt;/a&gt;&lt;/div&gt;'

script_body = ''

if script_link:
    edit_links = '&lt;div style="font-size: 12pt; padding: 20px"&gt;&lt;a href="{0}"&gt;Link to Google Docs &lt;/a&gt;|&lt;a href="#" class="add_pop"&gt; Edit Script Link&lt;/a&gt;&lt;/div&gt;'.format(script_link)
    if script_link.find('/edit#') != -1:
        script_body = '''&lt;object data="{0}" width="100%" height="700"&gt;&lt;embed src="{0}" width="100%" height="700"&gt; &lt;/embed&gt;
            Error: Embedded data could not be displayed.
            &lt;/object&gt;'''.format(script_link.replace('/edit#', '/htmlview#'))
    else:
        script_body = '''&lt;object data="{0}" width="100%" height="700"&gt;&lt;embed src="{0}" width="100%" height="700"&gt; &lt;/embed&gt;
            Error: Embedded data could not be displayed.
            &lt;/object&gt;'''.format(script_link)
]]>
</mako>
<html>
<element>
  <display class="tactic.ui.panel.CustomLayoutWdg">
    <html>
    ${edit_links}
    <br/>
    ${script_body}
    </html>
  </display>
</element>
</html>
<behavior class="add_pop"><![CDATA[{
  "type": "click_up",
  "cbjs_action": '''
var class_name = "tactic.ui.panel.EditWdg";
var search_key = bvr.kwargs.search_key;
var mode = "edit";
var view = "edit";
var kwargs = {
'search_key': search_key,
'view': view,
'mode': mode,
'title': 'Editing Script Link',
'ignore': 'name|preview|description|keywords|duration'
}
var popup = spt.panel.load_popup(view, class_name, kwargs);
'''
}]]></behavior>
</episodes.columns.script>
</config>""")
