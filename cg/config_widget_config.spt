<html>
<div class="spt_top" style="width:800; height:400">
  <div>
    <b>BASE_DIR: </b>
    <input type="text" class="spt_base_dir" size="40"/>
    <b>PATTERN: </b>
    <input type="text" class="spt_pattern" size="60"/>
  </div>
  <input type="button" class="spt_introspect_button" value="Introspect Source"/>
  <input type="button" class="spt_ingest_button" value="Ingest Source"/>
  <input type="button" class="spt_delete_button" value="Delete Introspection"/>
  <div style="margin-top 20px; padding:10px; -moz-border-radius:10px; background:141414;" id="spt_ingest_item_table"/>
</div>
<element>
  <display class="tactic.ui.panel.CustomLayoutWdg">
    <html><br/>
      ${gdocks_link}
    </html>
  </display>
</element>
</html>
<behavior class="spt_top"><![CDATA[{
    "type": "load",
    "cbjs_action": '''
    var server = TacticServerStub.get();
    var applet = spt.Applet.get();
    var top_el = bvr.src_el;
    var base_dir_el = top_el.getElement('.spt_base_dir');    
    var pattern_el = top_el.getElement('.spt_pattern');
    
    //Test that the handoff dir is available
    var base_dirs = server.get_base_dirs();
    var handoff_dir = base_dirs.win32_client_handoff_dir
    var is_dir = applet.is_dir(handoff_dir)
    if (!is_dir) {
        alert("The Handoff Directory is not available, please check the TACTIC Config File")
        var ingest_button_el = top_el.getElement(".spt_ingest_button")
        ingest_button_el.disabled = "true";
    }

    var ingest = server.get_by_search_key(bvr.kwargs.search_key)
    top_el.ingest_code = ingest.code; 
 
    pattern_el.value = ingest.pattern    
    base_dir_el.value = ingest.base_path

    var expr = "@SOBJECT(di/ingest_item['ingest_code', '"+ top_el.ingest_code +"'])";
    var kwargs = {
        'search_type': 'di/ingest_item',
        'view': 'ingest_item_list',
        'expression': expr
     }
     spt.panel.load("spt_ingest_item_table", "tactic.ui.panel.TableLayoutWdg", kwargs)


'''
}]]></behavior>


<behavior class="spt_introspect_button"><![CDATA[{
    "type": "click_up",
    "cbjs_action": '''
       
    
    //------- Options and Test Variables------------------------------------

    var top_el = bvr.src_el.getParent('.spt_top');
    var base_dir_el = top_el.getElement('.spt_base_dir');    
    var pattern_el = top_el.getElement('.spt_pattern');
    

    var BASE_DIR = base_dir_el.value;
    var PATTERN = pattern_el.value;
    var COLUMN = "code";
    var SEARCH_TYPE = "di/shot"; 
    var CONTEXT = "received";
    var ingest_code = top_el.ingest_code;


    var applet = spt.Applet.get();
    var server = TacticServerStub.get();

    //--------------------------------------------------------

    get_paths_to_depth = function(base_dir, pattern) {
        var temp_array = [];
        var path_array = [];
 
        var pattern_parts = pattern.split('/');
        var depth = pattern_parts.length;
        path_array = applet.list_dir(base_dir);

        // Loop through the tree to the correct depth
        for (j=0; j < depth-1; j++) {
            for (k=0; k < path_array.length; k++) {
                var paths = applet.list_dir(path_array[k]);
                for (l=0; l<paths.length; l++) {
                    if (applet.is_dir(paths[l])) {
                        temp_array.push(paths[l]);
                    }
                }
            }
            path_array = temp_array;
            temp_array = [];
        }

        return path_array;

    }



    get_object_depth_in_pattern = function(base_dir, pattern) {
        var pattern_parts = pattern.split("/");
        for (i=0; i<pattern_parts.length; i++) {
            if (pattern_parts[i].indexOf("{code}") != -1 ) {
                var code_index  = i; 
            }
        }
        var base_parts = base_dir.split("/")
        var path_depth = base_parts.length + code_index 

        return path_depth
    }


    generate_ingest_items = function(path_array, object_depth, ingest_code) {
        var objects = [];
    
        for (i=0; i<path_array.length; i++) {
            var object = new Object;

            var sys_path = path_array[i];
            path = sys_path.replace(/\\\\\\/g,'/')
            //path = sys_path

            var parts = path.split("/");
            var code = parts[object_depth];
            spt.app_busy.show("Introspecting", code)


            var files_list = applet.list_dir(path_array[i]);

            
            var sobject_expr =  "@SOBJECT("+SEARCH_TYPE+"['"+ COLUMN +"', '"+code+"'])";
            var sobject = server.eval(sobject_expr);
            if (sobject[0]) {

                var data = {
                    'search_type': SEARCH_TYPE,
                    'search_id': sobject[0].id,
                    'ingest_path': path,
                    'ingest_code': ingest_code
                }                
            }
            else {
                var data = {
                    'ingest_path': path,
                    'ingest_code': ingest_code
                }
            }      
            server.insert("di/ingest_item", data); 
        }
           
    }


    load_ingest_item_table = function(ingest_code) {
        var expr = "@SOBJECT(di/ingest_item['ingest_code', '"+ ingest_code +"'])";

        var kwargs = {
            'search_type': 'di/ingest_item',
            'view': 'ingest_item_list',
            'expression': expr
         }
         spt.panel.load("spt_ingest_item_table", "tactic.ui.panel.TableLayoutWdg", kwargs)

    }

    //-------EXECUTE--------------------------------------------------------------

    try {


        var path_array = get_paths_to_depth(BASE_DIR, PATTERN);

        var object_depth = get_object_depth_in_pattern(BASE_DIR, PATTERN);

        var answer = confirm(path_array.length +" items found.  Would you like to comtinue?");

        if (answer) {
            generate_ingest_items(path_array, object_depth, ingest_code);
            load_ingest_item_table(ingest_code);
        }

        
        alert("introspect complete")
        spt.app_busy.hide();
    }
    catch(err) {
        alert(err);

    }

'''
}]]></behavior>


<behavior class="spt_ingest_button"><![CDATA[{
    "type": "click_up",
    "cbjs_action": '''
  
    //------Options and Setup ------------------------------------------------------
    var CONTEXT = "received";
    var top_el = bvr.src_el.getParent('.spt_top');
    var ingest_code = top_el.ingest_code;

    var applet = spt.Applet.get();
    var server = TacticServerStub.get();

    //-------------------------------------------------------------------------------------



    ingest_items_to_sobjects = function(ingest_code, context) {

        var expr = "@SOBJECT(di/ingest_item['ingest_code', '"+ ingest_code +"'])"
        var ingest_items = server.eval(expr)

        for (i=0; i<ingest_items.length; i++) {
            
            try {
                var ingest_item = ingest_items[i];

                if (ingest_item.search_id) {

                    var search_type = ingest_item.search_type;
                    var search_id = ingest_item.search_id;                
                    var source_path = ingest_item.ingest_path;

                    var sobject_expr = "@SOBJECT("+search_type+"['id', '"+search_id+"'])"
                    var sobject = server.eval(sobject_expr, {'single': 'true'})
                    var log_message = "Ingesting SObject [" + sobject.code + "]";
                  
                    spt.app_busy.show("Ingestion", log_message);
                       

                    server.start({'title': 'Ingesting SObject', 'description': log_message});

                    // Used for direct copying on a local network  
                    var snapshot  = server.directory_checkin(sobject.__search_key__, context, source_path+"/", {'mode': 'copy'});




                    // Used for http copying on a WAN 
                    //var  ticket = server.get_transaction_ticket();
                    //var files = applet.list_dir(source_path);
                    //for (k=0; k<files.length; k++) {
                    //    server.upload_file(files[k], ticket)
                    //}
                    //var snapshot  = server.directory_checkin(sobject.__search_key__, context, source_path+"/", {'mode': 'uploaded'});





                    var data = {
                        'snapshot_code': snapshot.code,
                        'ingest_status': 'complete'
                    }
                    server.update(ingest_item, data);
                    server.finish();
                }
                else {
                    var data = {'ingest_status': 'no_sobject'}
                    server.update(ingest_item, data);
                }
            }
        
            catch(err) {
                var data = {
                  'ingest_status': 'failed'
                }
                server.update(ingest_item, data);
                alert(err)
                

            }
        }
        spt.app_busy.hide()
    }



    //--------------------------------------------------------------

    try {  

   ingest_items_to_sobjects(ingest_code, "ingest");   
    alert("Ingest complete");
    }
    catch(err) {
        alert(err);
        spt.app_busy.hide();
    }

'''
}]]></behavior>


<behavior class="spt_delete_button"><![CDATA[{
    "type": "click_up",
    "cbjs_action": '''
  
    //------Options and Setup ------------------------------------------------------
    var top_el = bvr.src_el.getParent('.spt_top');
    var ingest_code = top_el.ingest_code;

    var applet = spt.Applet.get();
    var server = TacticServerStub.get();

    try {  

        var expr = "@SOBJECT(di/ingest_item['ingest_code', '"+ ingest_code +"'])"
        var ingest_items = server.eval(expr)

        for (i=0; i<ingest_items.length; i++) {
            var ingest_item = ingest_items[i];
            spt.app_busy.show("Deleting", ingest_item.code)
            server.delete_sobject(ingest_item)
        }
        spt.app_busy.hide();
        
        // Refresh the table
        var expr = "@SOBJECT(di/ingest_item['ingest_code', '"+ top_el.ingest_code +"'])";
        var kwargs = {
            'search_type': 'di/ingest_item',
            'view': 'ingest_item_list',
            'expression': expr
        }
        spt.panel.load("spt_ingest_item_table", "tactic.ui.panel.TableLayoutWdg", kwargs)




    }
    catch(err) {
        alert(err);
        spt.app_busy.hide();
    }

'''
}]]></behavior>
</episodes.columns.script_dev>
</config>""")
