insert = SearchType.create('config/widget_config')
insert.set_value('category', """CustomLayoutWdg""")
insert.set_value('code', """WIDGET_CONFIG00217""")
insert.set_value('config', """<config>
<episodes_navigator_wdg>
<mako>
<![CDATA[
from pyasm.biz import DebugLog
from pyasm.search import Search
from pyasm.biz import Pipeline
import json

pipeline_code = 'cg/scenes'

pipeline = Pipeline.get_by_code(pipeline_code)

processes = pipeline.get_processes()

current_processes = kwargs.get('current_selected')

if current_processes:
    current_processes = eval(current_processes)
    if len(current_processes) &lt; 2:
        if current_processes[0] == u'':
            current_processes = current_processes[0]

#log = DebugLog.log("debug", current_processes)
#DebugLog.log("debug", str(current_processes))

def get_uncomplete_assets():
    episodes_sobjects = Search.eval("@SOBJECT(cg/scenes)")
    assets_sobjects = None
    uncomplete_episodes = set()
    
    assets_tasks = Search.eval("@SOBJECT(cg/assets.sthpw/task['process', 'publish'])")
    assets_sobjects = Search.eval("@SOBJECT(cg/scenes.cg/assets)")

    for ep_sboject in episodes_sobjects:

        found = False
        for as_sobject in assets_sobjects:
            if as_sobject.data['_related_code'] == ep_sboject.data['code']:
                if not found:

                    for tsk in assets_tasks:
                        if tsk.data['search_code'] == as_sobject.data['code']:
                            if tsk.data['status'] != u'Опубликован':
                                uncomplete_episodes.add(ep_sboject)
                                found = True
                                break
      
    return list(uncomplete_episodes)


def get_render_scene_without_tasks(process):
    
    render_current_statuses = ['Подготовлен', 'В очереди', 'Рендер', 'Рендерится', 'Ошибки', 'Готов']
    
    sobjects = Search.eval(u"@SOBJECT(sthpw/task['search_type', 'cg/scenes?project=dolly3d']['process', 'render']['status', 'in', '{1}'].parent)".format(process.get_name(), '|'.join(render_current_statuses)))

    return sobjects


#def get_scenes_without_tasks():
#
#    processes_dict = {}    
#    
#    for pr in processes:
#        processes_dict[pr.get_name()] = set()
#    
#    tsk = Search.eval("@SOBJECT(sthpw/task)")
#    scenes = Search.eval("@SOBJECT(cg/scenes)")
#    
#    for p, ls in processes_dict.items():
#        for scn in scenes:
#            for ts in tsk:
#                if not (ts.data['search_code'] == scn.data['code'] and ts.data['process'] == p):
#                    processes_dict[p].add(scn)
#                    tsk.remove(ts)
#
#    return processes_dict


def get_scene_without_tasks(proc):
    
    publish_tasks = Search.eval(u"@GET(sthpw/task['search_code','like','SCENES%']['process', 'publish']['status', 'in', 'Опубликован'].search_code)")
    
    part_two = Search.eval(u"@GET(sthpw/task['search_code','like','SCENES%']['process', '{0}'].search_code)".format(proc))
    
    all_parts = []
    
    for prc in part_two:
        if prc not in publish_tasks:
            all_parts.append(prc)
    
    all_parts.extend(publish_tasks)
    

    expr = "@SOBJECT(cg/scenes['code', 'not in', '{0}'])".format('|'.join(all_parts))

    return Search.eval(expr)


process_episodes_list = []
unassigned_scenes = None

# TODO CHECK WHY PROCESS COULD BE EMPY
for process in processes:
    if process:
        if process.get_name() == 'assets':
            sobjects = get_uncomplete_assets()
            #DebugLog.log("debug", str(sobjects))
    
        elif process.get_name() == 'render':
            sobjects = get_render_scene_without_tasks(process)
    
        elif not current_processes:
            sobjects = []
            # getting all scenes with tasks without status
            #sobjects = Search.eval(u"@SOBJECT(cg/scenes.sthpw/task['process', '{0}']['status', 'is', 'NULL'].parent)".format(process.get_name()))
            # getting all scenes without tasks
            #if not unassigned_scenes:
            #    unassigned_scenes = get_scenes_without_tasks()
            #sobjects.extend(unassigned_scenes[process.get_name()])
            sobjects.extend(get_scene_without_tasks(process.get_name()))
        else:
            sobjects = Search.eval(u"@SOBJECT(sthpw/task['search_type', 'cg/scenes?project=dolly3d']['process', '{0}']['status', 'in', '{1}'].parent)".format(process.get_name(), '|'.join(current_processes)))
        process_episodes_list.append((process, sobjects))
        sobjects_list = []
        for sobj in sobjects:
            if sobj:
                sobjects_list.append(sobj.get_search_key())
        kwargs[process.get_name()] = sobjects_list

process_select = u'''

&lt;select style="margin: 0px 0px 0px 0px;border-width: 1px;height: 18px;padding: 0px;border-color: #737b79; font-size: 12px; color: #AAA;width: 100;border-style: solid;background: #5d5d5d;display: inline" class="inputfield input-sm form-control spt_input"&gt;
    &lt;option selected="selected"&gt;эпизод&lt;/option&gt;
    {0}
&lt;/select&gt;

'''

process_cell_div_OLD = u'''

&lt;div id="process_cell"&gt;
    &lt;div id="process_link"&gt;
        &lt;a href="{3}" class="spt_input process_link proc_link_a"&gt;{0} | {1}&lt;/a&gt;
    &lt;/div&gt;
    &lt;div style="padding: 3px;"&gt;
    {2}
    &lt;/div&gt;
&lt;/div&gt;

'''
process_cell_div = u'''

&lt;div id="process_cell"&gt;
    &lt;div id="process_link"&gt;
        &lt;a href="{2}" class="spt_input process_link proc_link_a"&gt;{0} | {1}&lt;/a&gt;
    &lt;/div&gt;
&lt;/div&gt;

'''
process_divs_list = []
for proc, sobj in process_episodes_list:
    if proc:
        label = proc.get_label()
        if not label:
            label = proc.get_name().capitalize()
            
        if label == u'Assets':
            label = u'Ассеты'
            
        selects_list = []
        for s in sobj:
            if s:
                selects_list.append(u'&lt;option&gt;{0}&lt;/option&gt;'.format(s.get_name()))
        
        process_selecttion = process_select.format(u''.join(selects_list))
        
        process_divs_list.append(
            process_cell_div.format(label, len(sobj), proc.get_name())
            )

episodes_navigation = u'''
&lt;div class="main_wrap"&gt;

{0}

&lt;/div&gt;

'''.format(u''.join(process_divs_list))
]]>
</mako>
<html>
<div style="padding-top: 4px;">${episodes_navigation}</div>
<style type="text/css">
.main_wrap{
  display:table;
  width:0%;
  padding-left: 0px;
}

#process_cell{
    display: table-cell;
    height: 30px;
    float: center;
    width: 126px;
    font-size: 10pt;
    padding: 0px;
    border: 0px solid #999999;
    text-align: center;
}

#process_link{
  font-size: 10pt;
  padding: 5px;

}

.proc_link_a:link {
  color: rgb(192, 192, 192);
}


