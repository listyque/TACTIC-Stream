#-- Start Entry --#
table = CreateTable('cg/assets_in_assets')
table.add('child_assets_code',        'varchar', length='256' )
table.add('code',                     'varchar', length='256' )
table.add('id',                       'serial', primary_key=True)
table.add('parent_assets_code',       'varchar', length='256' )
table.add('relative_dir',             'text' )
table.add('s_status',                 'varchar', length='256' )
table.add('timestamp',                'timestamp' )
table.add_constraint(["code"], mode="UNIQUE")
