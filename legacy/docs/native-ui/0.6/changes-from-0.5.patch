+  self.assertEqual(a,b);self.assertEqual(calls,[b'hello']);self.assertEqual(a['sha256'],sha(b'hello'));self.assertEqual(a['state'],'complete');self.assertFalse((Path(self.tmp.name)/j['id']/'payload'/'sample.bin').exists())
