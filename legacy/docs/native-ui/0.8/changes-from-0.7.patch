--- /dev/null
+++ b/tools/local/local_lock.py
@@ -0,0 +1,27 @@
+"""Cooperative lifetime lock shared by the local server and its upgrader."""
+from contextlib import contextmanager
+import os
+from pathlib import Path
+
+@contextmanager
+def local_lock(data: Path):
+    data.mkdir(parents=True,exist_ok=True)
+    path=data/'.native-local.lock'
+    handle=path.open('a+b')
+    try:
+        handle.seek(0,os.SEEK_END)
+        if handle.tell()==0:handle.write(b'0');handle.flush()
+        handle.seek(0)
+        try:
+            if os.name=='nt':
+                import msvcrt
+                msvcrt.locking(handle.fileno(),msvcrt.LK_NBLCK,1)
+            else:
+                import fcntl
+                fcntl.flock(handle.fileno(),fcntl.LOCK_EX|fcntl.LOCK_NB)
+        except OSError as exc:
+            raise RuntimeError('Another local TACTIC server/upgrade is active. Stop it before continuing.') from exc
+        yield
+    finally:
+        # Closing releases OS locks even after exceptions or process death.
+        handle.close()
