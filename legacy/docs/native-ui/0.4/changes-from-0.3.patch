--- /dev/null
+++ b/3rd_party/python3/site-packages/cherrypy/lib/_cgi_header.py
@@ -0,0 +1,40 @@
+"""CPython 3.12 cgi.parse_header, retained for bundled CherryPy on Python 3.13+.
+
+Only the two original header parsing functions are included, unmodified.
+Source: https://github.com/python/cpython/blob/v3.12.0/Lib/cgi.py
+Copyright Python Software Foundation; PSF-2.0, see LICENSE_PSF_HEADER.txt.
+This is NOT a replacement for cgi.FieldStorage or the TACTIC multipart handler.
+"""
+
+def _parseparam(s):
+    while s[:1] == ';':
+        s = s[1:]
+        end = s.find(';')
+        while end > 0 and (s.count('"', 0, end) - s.count('\\"', 0, end)) % 2:
+            end = s.find(';', end + 1)
+        if end < 0:
+            end = len(s)
+        f = s[:end]
+        yield f.strip()
+        s = s[end:]
+
+
+def parse_header(line):
+    """Parse a Content-type like header.
+
+    Return the main content-type and a dictionary of options.
+
+    """
+    parts = _parseparam(';' + line)
+    key = parts.__next__()
+    pdict = {}
+    for p in parts:
+        i = p.find('=')
+        if i >= 0:
+            name = p[:i].strip().lower()
+            value = p[i+1:].strip()
+            if len(value) >= 2 and value[0] == value[-1] == '"':
+                value = value[1:-1]
+                value = value.replace('\\\\', '\\').replace('\\"', '"')
+            pdict[name] = value
+    return key, pdict
