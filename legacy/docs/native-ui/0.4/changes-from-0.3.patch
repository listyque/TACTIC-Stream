+        search = Search("sthpw/work_hour")
+
+        if self.kwargs.get('show_all_users') != 'true':
+
+            search.add_user_filter()
+
+        search.add_filter("day", start_date, ">=")
+        search.add_filter("day", end_date, "<=")
