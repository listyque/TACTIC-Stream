+@echo off
+setlocal DisableDelayedExpansion
+cd /d "%~dp0"
+set "PYTHON=%~dp0.runtime\python\python.exe"
+if defined TACTIC_PYTHON set "PYTHON=%TACTIC_PYTHON%"
