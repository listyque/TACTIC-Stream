+.editor-status{color:var(--ui-draft,var(--ui-muted));font-size:11px;line-height:1.4;white-space:nowrap}
+.editor-context{font-size:11px;max-width:100%;overflow-wrap:anywhere}
+.catalog-actions{display:flex;gap:6px;margin:0 0 8px}.catalog-actions button{flex:1;min-height:30px;font-size:12px}
+.design-workbench,.stype-workbench,.sidebar-workbench,.security-workspace,.script-editor,.config-workbench,.global-settings,.admin-panel,.collection-panel{padding:8px var(--widget-inset);min-width:0;min-height:0;overflow:auto}
+.design-workbench,.stype-workbench,.sidebar-workbench,.security-workspace{flex:1}
+.script-editor{gap:8px;flex:1}.script-toolbar{margin-bottom:0}.message-center-title.widget-toolbar{padding:6px 10px;margin:0;min-height:42px}
+.admin-panel .widget-toolbar{padding-left:0}.admin-panel:has(>.project-wizard){padding-top:0}
+.admin-two-pane{min-height:360px;border-radius:8px}.admin-catalog{padding:10px;max-height:calc(100dvh - 150px)}.admin-editor-pane{padding:10px 12px}
+.admin-editor-pane>.toolbar:first-child{padding-top:0}.admin-section-tabs{padding:3px;margin-bottom:8px;border-radius:7px;gap:3px}.admin-section-tabs button{padding:6px 10px;font-size:12px}
+.sidebar-editor-tools{padding-top:0;margin-top:0}.security-workspace>.widget-toolbar>.toolbar{justify-content:flex-start}
+.workspace>.widget-host{min-height:0;flex:1;overflow:auto}.widget-host{min-width:0}
+.embedded-form-frame{margin:0 auto;width:100%;max-width:950px}.embedded-form{padding:8px 10px;border-radius:6px}
+.modal>header{padding:10px 14px;gap:10px;min-height:40px}.modal>header h2{font-size:16px;margin:0;line-height:1.35}.modal>header small{font-size:10px}
+.project-wizard{width:min(780px,100%);margin:8px auto;padding:0 12px}.wizard-steps{margin:6px 0 14px;gap:8px}.wizard-steps li{padding-bottom:8px;font-size:12px}.wizard-actions{margin-top:12px;padding:12px 0}
+.welcome{padding:12px 16px}.welcome>p{margin:0 0 12px}.section-cards{gap:12px}
+/* Never leave a fixed-height intro spacer after removing the title blocks. */
+.widget-toolbar+.notice,.widget-toolbar+.error{margin-top:0}.collection-panel .collection-breadcrumb{margin-top:6px}
+@media(max-width:700px){:root{--widget-inset:8px}.workspace-tabbar>.workspace-tabs{padding-left:4px}.workspace-actions{padding-left:2px;padding-right:2px}.workspace-actions .workspace-action{width:28px;height:30px}.widget-toolbar>label{flex-wrap:wrap}.admin-two-pane{min-height:0}.admin-catalog{max-height:240px}.admin-editor-pane{padding:10px 8px}.project-wizard{padding:0 4px}.modal>header{padding:8px 10px}}
+
+/* Fill the viewport from the tabs, never vertically center a workbench. */
+.design-workbench{width:100%;max-width:none;margin:0}
+.membership-panel{padding:8px var(--widget-inset)}
+.native-tab-content{padding-top:4px}
