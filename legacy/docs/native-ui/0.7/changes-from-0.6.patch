+        show_insert = self.view_attributes.get("insert") or True
+
+        # if edit_permission on the sobject is not allowed then we don't
+        # allow insert
+        if self.edit_permission == False:
+            show_insert = False
+
+        if show_insert:
+            show_insert = self.get_setting("insert")
+
+        return show_insert
