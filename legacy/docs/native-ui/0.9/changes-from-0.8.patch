+    @staticmethod
+    def resolve_class(class_path):
+        """Resolve a trusted TACTIC configuration class without exec locals.
+
+        This does not authorize HTTP input. Callers must resolve/authorize their
+        server configuration first. Short names retain Marshaller's historical
+        widget -> command -> web search order; plugin loading keeps its loader.
+        No instance is created simply to ask a class for its default handler.
+        """
+        import importlib
+        if not isinstance(class_path, str) or not class_path or any(
+                not part.isidentifier() for part in class_path.split('.')):
+            raise ValueError("Invalid TACTIC class path: %r" % (class_path,))
+        module_name, _, class_name = class_path.rpartition('.')
+        if module_name.startswith('tactic.plugins.'):
+            plugins = importlib.import_module('tactic.plugins')
+            parts = class_path.split('.')
+            obj = plugins.import_plugin(parts[2])
+            for name in parts[3:]:
+                obj = getattr(obj, name)
+            return obj
+        if module_name:
+            return getattr(importlib.import_module(module_name), class_name)
+        for name in ('pyasm.widget', 'pyasm.command', 'pyasm.web'):
+            try:
+                module = importlib.import_module(name)
+            except ImportError:
+                continue
+            if hasattr(module, class_name):
+                return getattr(module, class_name)
+        raise ImportError("Could not find '%s' for import" % class_path)
