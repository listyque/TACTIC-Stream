+        obj = self._object(opened['search_type'], text(data.get('key'), 'key', 1500))
+        parent = obj.get_parent() if opened['search_type'] == 'sthpw/task' else obj
+        if parent is None:
+            raise ApiError(404, 'task_parent', 'Родитель задачи не найден')
