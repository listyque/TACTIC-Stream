+
+        from dateutil import parser
+        try:
+            if re.search('day|week|hour|month',value, flags=re.IGNORECASE):
+                is_date = False
+            else:
+                parser.parse(value)
+                is_date = True
+        except:
+            is_date = False
+
+        #import re
+        #p = re.compile("\d+-\d+-\d")
+        #if re.match(p, value):
+        if is_date:
