+                old = sub.find(key)
+                if val is None:
+                    if old is not None:
+                        sub.remove(old)
+                else:
+                    if not isinstance(val, str) or len(val) > 128 * 1024:
+                        raise ValueError('Option must be bounded text')
+                    if old is None:
+                        old = ET.SubElement(sub, key)
+                    # Do not accidentally flatten a structured nested XML option.
+                    if len(old):
