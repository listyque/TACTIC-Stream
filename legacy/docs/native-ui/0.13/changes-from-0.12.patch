+.table-columns-dialog{border:1px solid var(--ui-line);padding:0;border-radius:12px;background:var(--ui-raised);color:var(--ui-text);width:min(420px,calc(100vw - 24px));max-height:calc(100dvh - 40px);box-shadow:var(--ui-shadow);overflow:hidden}
+.table-columns-dialog[open]{display:flex;flex-direction:column}.table-columns-dialog::backdrop{background:var(--ui-backdrop)}
+.table-columns-dialog>header{display:flex;align-items:center;justify-content:space-between;padding:18px 18px 14px;border-bottom:1px solid var(--ui-line);gap:10px}
+.table-columns-dialog h2{margin:0 0 4px;font-size:16px;letter-spacing:-.02em}.table-columns-dialog small{font-size:10px;color:var(--ui-muted);line-height:1.5}
+.table-columns-dialog>header>button{border:0;background:transparent;color:var(--ui-muted);font-size:18px;line-height:1;padding:6px}
+.table-columns-dialog>.column-search{margin:12px 14px;width:calc(100% - 28px);flex-shrink:0}
+.table-column-list{overflow:auto;padding:0 8px 10px;min-height:40px;max-height:52vh;scrollbar-width:thin}
+.table-column-option{display:flex;align-items:center;gap:6px;padding:2px 6px;border-radius:6px}.table-column-option:hover{background:var(--ui-hover)}
+.table-column-option>label{display:flex;align-items:center;gap:10px;flex:1;min-width:0;padding:7px 0;font-size:12px;cursor:pointer}.table-column-option>label>span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.table-column-option small{display:block;line-height:1.4}.table-column-option input{flex:none;width:14px;height:14px}
+.table-columns-dialog .column-pin{flex:none;width:30px;height:30px;padding:6px;border:0;background:transparent;color:var(--ui-muted)}.table-columns-dialog .column-pin.active{color:var(--ui-accent);background:var(--ui-accent-soft)}
+.table-columns-dialog>footer{display:flex;align-items:center;gap:12px;justify-content:space-between;padding:13px 16px;border-top:1px solid var(--ui-line)}.table-columns-dialog>footer>button{font-size:10px;white-space:nowrap}
+.widget-table>.widget-table-heading{padding:12px 16px 0;border:0;min-height:0}.widget-table-heading h3{font-size:14px;font-weight:600;margin:0 0 3px}.widget-table>.native-grid{border:0}
+.modal.table-diagnostics{padding-bottom:20px}.table-diagnostics>p,.table-diagnostics>small,.table-diagnostics>div{margin:12px 20px}.table-diagnostics>small{display:block;color:var(--ui-muted)}.table-diagnostics code{overflow-wrap:anywhere}
