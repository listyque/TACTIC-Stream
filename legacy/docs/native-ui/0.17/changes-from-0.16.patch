+            edit_config = SearchType.create("config/widget_config")
+            edit_config.set_value("search_type", search_type)
+            edit_config.set_value("view", "edit_definition")
+            edit_config.commit()
+            edit_config._init()
+
+
+        for data in values:
+
+            name = data.get("name")
